      "Narrative Intelligence"
    ]
  },
  "runtimeState": {
    "record": "WerewolfRuntimeCharacterState",
    "namespace": "Chronicle.RuleSets.Werewolf.CharacterCreation",
    "properties": [
      "PackageId",
      "PackageVersion",
      "DraftId",
      "RuntimeStateVersion",
      "PackageBinding",
      "RagePermanent",
      "RageCurrent",
      "GnosisPermanent",
      "GnosisCurrent",
      "WillpowerPermanent",
      "WillpowerCurrent"
    ],
    "versioning": {
      "type": "monotonically increasing integer",
      "startsAt": 1,
      "incremented": "exactly once per successful transition",
      "source": "separate from creation DraftVersion"
    }
  },
  "werewolfOperations": {
    "project": "Chronicle.RuleSets.Werewolf",
    "operations": [
      {
        "key": "character-runtime.spend-resource",
        "capability": "post-creation-character-operations",
        "status": "enabled",
        "inputs": [
          "requestId",
          "currentState",
          "expectedRuntimeStateVersion",
          "resourceId",
          "amount"
        ],
        "outputs": [
          "requestId",
          "newState",
          "newRuntimeStateVersion",
          "previousCurrent",
          "newCurrent",
          "previousPermanent",
          "newPermanent"
        ],
        "validates": [
          "state present and well-formed",
          "package binding valid",
          "draft bound to completed character",
          "expected runtime state version matches",
          "resource identifier recognized",
          "amount is positive integer",
          "current value >= amount"
        ],
        "transition": "newCurrent = current - amount, newPermanent = permanent (unchanged)"
      },
      {
        "key": "character-runtime.recover-resource",
        "capability": "post-creation-character-operations",
        "status": "enabled",
        "inputs": [
          "requestId",
          "currentState",
          "expectedRuntimeStateVersion",
          "resourceId",
          "amount"
        ],
        "outputs": [
          "requestId",
          "newState",
          "newRuntimeStateVersion",
          "previousCurrent",
          "newCurrent",
          "previousPermanent",
          "newPermanent"
        ],
        "validates": [
          "state present and well-formed",
          "package binding valid",
          "draft bound to completed character",
          "expected runtime state version matches",
          "resource identifier recognized",
          "amount is positive integer",
          "current + amount <= permanent"
        ],
        "transition": "newCurrent = current + amount, newPermanent = permanent (unchanged)"
      }
    ]
  },
  "chronicleApplication": {
    "project": "Chronicle.Application",
    "services": [
      "ResourceTransitionOrchestrator (instance: runtime state -> request resource transition -> receive deterministic new state -> return to caller)"
    ],
    "orchestrationFlow": [
      "runtime character state",
      "request resource transition through registered Rule Set runtime",
      "receive deterministic new runtime state/result",
      "return it to caller"
    ],
    "mustNotContain": [
      "Rage/Gnosis/Willpower identifiers",
      "Werewolf-specific bounds",
      "Werewolf concrete service references"
    ]
  },
  "approvedSemantics": [
    "Mutable runtime values are the .current values of character.resource.rage, character.resource.gnosis, character.resource.willpower",
    ".permanent values remain unchanged by PLAYABLE-002",
    "Spending cannot reduce current below zero",
    "Recovery cannot increase current above permanent",
    "Invalid transitions are rejected rather than silently clamped",
    "Both operations require completed character state binding",
    "Both operations require positive integer amount",
    "Both operations require expected runtime-state version (optimistic concurrency)",
    "Runtime state version increments exactly once per successful transition",
    "Resource identifiers support base and .current suffixed forms only; .permanent identifiers are rejected",
    "Creation snapshot remains immutable historical completion evidence"
  ],
