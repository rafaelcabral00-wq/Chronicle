  "decisionGovernance": {
    "existingDecisionSetReopened": false,
    "newDecisionRequestRequired": true,
    "decisionRequestArtifact": "docs/reviews/documentation-reconciliation/decision-requests/DR-0007-werewolf-character-completion-boundary.md",
    "decisionBoundary": "Approves only IMPLEMENT-021 completion validation, snapshot contract, and complete-character operation boundary. Does not approve persistence, activation, ledger persistence, events, timestamps, optional identity fields, Renown, or post-creation runtime."
  },
  "implement021Scope": {
    "approved": true,
    "description": "Completion validation and atomic character completion boundary for the current executable slice.",
    "validator": {
      "type": "pure",
      "inputs": ["draft state"],
      "outputs": ["deterministic findings", "completion eligibility", "validation fingerprint"],
      "sideEffects": "none"
    },
    "snapshot": {
      "type": "immutable completed-character snapshot",
      "contains": ["approved character state", "package binding", "validation result", "deterministic metadata"],
      "doesNotContain": ["timestamps", "persistence IDs", "provider data", "raw narrative text"],
      "immutable": true
    },
    "operation": {
      "operationKey": "character-creation.complete-character",
      "capabilityKey": "character-creation",
      "boundary": "atomic-after-mandatory-data-operations",
      "preconditions": [
        "draft-initialized",
        "draft-version-matches",
        "all-mandatory-current-slice-fields-complete",
        "no-open-blocking-invalidations",
        "identity-name-valid"
      ],
      "postconditions": [
        "draft-status-set-to-completed",
        "snapshot-produced",
        "validation-fingerprint-produced",
        "required-next-steps-cleared",
        "draft-version-incremented-exactly-once",
        "source-draft-unchanged-on-failure"
      ]
    },
    "idempotency": {
      "behavior": "explicit-rejection",
      "description": "If the draft is already in a completed state, the operation returns a deterministic canonical finding rather than returning a previous result."
    }
  },
  "implement021Exclusions": [
    "database-persistence",
    "chronicle-aggregate-activation",
    "creation-ledger-persistence",
    "snapshot-persistence",
    "timestamp-generation",
    "event-emission",
    "combat",
    "dice",
    "runtime-gifts",
    "advancement",
    "optional-identity-fields",
    "renown-behavior",
    "nature-and-demeanor",
    "additional-gift-purchase",
    "generic-dice",
    "post-creation-runtime"
  ],
  "implement021ExpectedProductionChanges": [
    "WerewolfCharacterCreationDraftContracts.cs: add Completed status to WerewolfCharacterDraftStatus",
    "WerewolfCharacterCompletion.cs: new file implementing pure completion validator, completion service, and snapshot contract",
    "WerewolfReferenceRuntime.cs: register and dispatch character-creation.complete-character",
    "RuleSetPackageSourceValidation.cs: add new file to package-source required/declared resource collections"
  ],
  "implement021RequiredTests": [
