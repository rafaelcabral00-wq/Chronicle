{
  "contractVersion": 1,
  "operationKey": "character-creation.set-ability-rating",
  "operationVersion": 1,
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "character-creation.operation.set-ability-rating",
  "descriptionResourceKey": "character-creation.operation.set-ability-rating.description",
  "publicationStatus": "prototype-candidate",
  "operationKind": "command",
  "scope": "CharacterCreation",
  "authority": {
    "requestAuthority": "ChronicleApplication",
    "validationAuthority": "RuleSet",
    "commitAuthority": "Chronicle",
    "narratorMayRequest": false,
    "narratorMayExecute": false
  },
  "idempotency": {
    "required": true,
    "keyScope": "character-ability-and-target-rating",
    "sameKeySameInputReturnsPreviousResult": true,
    "sameKeyDifferentInputRejected": true
  },
  "inputContract": {
    "inputKey": "SetAbilityRatingInput",
    "fields": [
      {
        "fieldKey": "characterId",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "draftVersion",
        "fieldType": "Integer",
        "required": true
      },
      {
        "fieldKey": "abilityKey",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "targetRating",
        "fieldType": "Integer",
        "required": true
      },
      {
        "fieldKey": "creationStage",
        "fieldType": "Text",
        "required": true,
        "allowedValues": [
          "CreationBaseAllocation",
          "CreationBonusPurchase"
        ]
      },
      {
        "fieldKey": "operationId",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "idempotencyKey",
        "fieldType": "Text",
        "required": true
      }
    ]
  },
  "preconditions": [
    {
      "preconditionKey": "set-ability-rating.character-is-draft",
      "requirement": {
        "entityType": "Character",
        "idField": "characterId",
        "field": "status",
        "operator": "equals",
        "value": "Draft"
      },
      "failureKey": "character-creation.set-ability-rating.not-a-draft"
    },
    {
      "preconditionKey": "set-ability-rating.draft-version-matches",
      "requirement": {
        "field": "draftVersion",
        "operator": "equals-current-character-version"
      },
      "failureKey": "character-creation.set-ability-rating.stale-draft"
    },
    {
      "preconditionKey": "set-ability-rating.ability-catalog-available",
      "requirement": {
        "artifactRef": "../character-model/catalogs/abilities.json",
        "operator": "readable-and-contract-compatible"
      },
      "failureKey": "character-creation.set-ability-rating.catalog-unavailable"
    },
    {
      "preconditionKey": "set-ability-rating.priority-assignment-present",
      "requirement": {
        "field": "character.abilities.priority-assignment",
        "operator": "exists"
      },
      "failureKey": "character-creation.set-ability-rating.priorities-not-set"
    }
  ],
  "validationRules": [
    {
      "ruleKey": "set-ability-rating.ability-valid",
      "ruleType": "catalog-membership",
      "severity": "blocking",
      "status": "candidate",
      "targetField": "abilityKey",
      "catalogRef": "../../character-model/catalogs/abilities.json#entries",
      "errorKey": "character-creation.set-ability-rating.invalid-ability"
    },
    {
      "ruleKey": "set-ability-rating.range",
      "ruleType": "range",
      "severity": "blocking",
      "status": "candidate",
      "targetField": "targetRating",
      "minimum": 0,
      "maximum": 5,
      "errorKey": "character-creation.set-ability-rating.out-of-range"
    },
    {
      "ruleKey": "set-ability-rating.base-allocation-cap",
      "ruleType": "stage-aware-range",
      "severity": "blocking",
      "status": "candidate",
      "appliesWhen": {
        "creationStage": "CreationBaseAllocation"
      },
      "targetField": "targetRating",
      "maximum": 3,
      "errorKey": "character-creation.set-ability-rating.base-allocation-cap-exceeded"
    },
    {
      "ruleKey": "set-ability-rating.category-budget-not-exceeded",
      "ruleType": "typed-budget",
      "severity": "blocking",
      "status": "candidate",
      "appliesWhen": {
        "creationStage": "CreationBaseAllocation"
      },
      "categorySource": "../../character-model/catalogs/abilities.json#entries[].categoryKey",
      "priorityField": "character.abilities.priority-assignment",
      "budgetByPriority": {
        "primary": 13,
        "secondary": 9,
        "tertiary": 5
      },
      "calculation": "projected sum(base-allocation points) by category",
      "errorKey": "character-creation.set-ability-rating.category-budget-exceeded"
    },
    {
      "ruleKey": "set-ability-rating.lupus-base-restriction",
      "ruleType": "conditional-prohibition",
      "severity": "blocking",
      "status": "candidate",
      "appliesWhen": {
        "creationStage": "CreationBaseAllocation",
        "character.classification.race": "character.race.lupus",
        "abilityKeyIn": [
          "character.ability.crafts",
          "character.ability.drive",
          "character.ability.etiquette",
          "character.ability.firearms",
          "character.ability.computer",
          "character.ability.law",
          "character.ability.linguistics",
          "character.ability.politics",
          "character.ability.science"
        ],
        "targetRating": {
          "operator": "greater-than",
          "value": 0
        }
      },
      "ambiguityRef": "ambiguity.werewolf3e.creation.lupus-restricted-abilities",
      "errorKey": "character-creation.set-ability-rating.lupus-base-allocation-prohibited"
    },
    {
      "ruleKey": "set-ability-rating.freebie-budget-available",
      "ruleType": "ledger-budget",
      "severity": "blocking",
      "status": "candidate",
      "appliesWhen": {
        "creationStage": "CreationBonusPurchase",
        "operator": "target-rating-increases-beyond-base-allocation-rating"
      },
      "ledgerRef": "character.creationLedger",
      "budgetKey": "character-creation.freebie-points",
      "costPerPoint": 2,
      "errorKey": "character-creation.set-ability-rating.insufficient-freebies"
    },
    {
      "ruleKey": "set-ability-rating.no-negative-freebie-refund",
      "ruleType": "ledger-consistency",
      "severity": "blocking",
      "status": "prototype",
      "appliesWhen": {
        "creationStage": "CreationBonusPurchase",
        "operator": "target-rating-decreases"
      },
      "requirement": {
        "operator": "refund-only-recorded-ability-freebie-purchases"
      },
      "errorKey": "character-creation.set-ability-rating.invalid-refund"
    }
  ],
  "ratingSourceModel": {
    "persistedRating": "character.abilities[].rating",
    "ledgerSources": [
      {
        "sourceKey": "base-initialization",
        "defaultPoints": 0,
        "cost": 0
      },
      {
        "sourceKey": "base-allocation",
        "points": "variable",
        "maximumResultingRating": 3,
        "cost": 0
      },
      {
        "sourceKey": "freebie-purchase",
        "points": "variable",
        "maximumResultingRating": 5,
        "costPerPoint": 2
      }
    ],
    "temporaryModifiersExcluded": true
  },
  "changeCalculation": {
    "mode": "ledger-aware",
    "steps": [
      "load-current-rating",
      "resolve-base-allocation-rating",
      "resolve-freebie-purchased-points",
      "calculate-target-stage-distribution",
      "calculate-category-budget-impact",
      "calculate-race-restriction-impact",
      "calculate-freebie-cost-or-refund",
      "calculate-specialization-impact",
      "calculate-validation-impact"
    ],
    "decreasePolicy": {
      "removeFreebiePointsBeforeBaseAllocationPoints": true,
      "neverReduceBelowZero": true,
      "refundOnlyCommittedFreebieEntries": true
    }
  },
  "restrictionPolicy": {
    "raceKey": "character.race.lupus",
    "restrictedAbilityKeys": [
      "character.ability.crafts",
      "character.ability.drive",
      "character.ability.etiquette",
      "character.ability.firearms",
      "character.ability.computer",
      "character.ability.law",
      "character.ability.linguistics",
      "character.ability.politics",
      "character.ability.science"
    ],
    "baseAllocation": "prohibited",
    "freebiePurchase": "source-review-required",
    "prototypeDecision": "Do not apply the prohibition automatically to freebie purchases until the source ambiguity is resolved."
  },
  "specializationImpact": {
    "eligibilityMinimumRating": 4,
    "whenTargetFallsBelowMinimum": {
      "removeSpecializationsAutomatically": false,
      "createInvalidation": true,
      "completionBlockedUntilResolved": true
    },
    "whenTargetReachesMinimum": {
      "specializationRequired": false,
      "showSuggestion": true,
      "status": "prototype-decision"
    }
  },
  "executionPlan": [
    {
      "order": 10,
      "stepKey": "load-current-ability-state",
      "executor": "ChronicleApplication",
      "effects": [
        "load-character-draft",
        "load-current-ability-rating",
        "load-priority-assignment",
        "load-ability-ledger-entries",
        "load-freebie-budget",
        "load-linked-specializations",
        "load-current-race"
      ]
    },
    {
      "order": 20,
      "stepKey": "validate-target-rating",
      "executor": "RuleSet",
      "effects": [
        "validate-ability-identity",
        "validate-rating-range",
        "validate-base-allocation-cap",
        "validate-category-budget",
        "validate-race-restrictions",
        "validate-freebie-budget"
      ]
    },
    {
      "order": 30,
      "stepKey": "calculate-ledger-delta",
      "executor": "RuleSet",
      "effects": [
        "calculate-base-allocation-delta",
        "calculate-freebie-purchase-delta",
        "calculate-refund-delta",
        "calculate-remaining-category-points",
        "calculate-remaining-freebie-points"
      ]
    },
    {
      "order": 40,
      "stepKey": "calculate-dependent-impact",
      "executor": "RuleSet",
      "effects": [
        "evaluate-specialization-eligibility",
        "identify-resolved-ability-invalidations",
        "identify-new-specialization-invalidations",
        "identify-race-restriction-invalidations"
      ]
    },
    {
      "order": 50,
      "stepKey": "persist-rating-change",
      "executor": "ChronicleApplication",
      "effects": [
        "record-previous-rating",
        "set-target-rating"
      ]
    },
    {
      "order": 60,
      "stepKey": "update-creation-ledger",
      "executor": "ChronicleApplication",
      "effects": [
        "append-base-allocation-entry-when-needed",
        "append-freebie-purchase-entry-when-needed",
        "append-freebie-refund-entry-when-needed",
        "preserve-ledger-history"
      ]
    },
    {
      "order": 70,
      "stepKey": "update-invalidations",
      "executor": "ChronicleApplication",
      "effects": [
        "clear-resolved-ability-budget-invalidations",
        "clear-resolved-race-restriction-invalidations",
        "create-specialization-eligibility-invalidations",
        "preserve-unrelated-invalidations"
      ]
    },
    {
      "order": 80,
      "stepKey": "run-affected-validation",
      "executor": "RuleSet",
      "effects": [
        "validate-ability-range",
        "validate-category-allocation",
        "validate-base-rating-cap",
        "validate-race-restrictions",
        "validate-freebie-budget",
        "validate-specialization-targets",
        "persist-validation-summary"
      ]
    },
    {
      "order": 90,
      "stepKey": "finalize-operation",
      "executor": "ChronicleApplication",
      "effects": [
        "record-operation-result",
        "increment-draft-version",
        "set-updated-at"
      ]
    }
  ],
  "invalidationContract": {
    "supportedTypes": [
      {
        "invalidationType": "AbilityCategoryBaseBudgetMismatch",
        "resolution": "Adjust one or more Ability base-allocation dots in the affected category."
      },
      {
        "invalidationType": "AbilityBaseAllocationRestrictedByRace",
        "resolution": "Remove the prohibited base-allocation dots or change Race."
      },
      {
        "invalidationType": "AbilitySpecializationNoLongerEligible",
        "resolution": "Remove or replace the specialization after confirming the rating reduction."
      }
    ],
    "automaticResolutionAllowed": false
  },
  "transactionPolicy": {
    "transactionBoundary": "single-authoritative-commit",
    "partialCommitAllowed": false,
    "persistOperationRecord": true,
    "persistCharacterDraft": true,
    "persistCreationLedger": true,
    "persistValidationSummary": true,
    "persistInvalidations": true
  },
  "resultContract": {
    "resultKey": "SetAbilityRatingResult",
    "fields": {
      "operationId": "Reference",
      "characterId": "Reference",
      "abilityKey": "Reference",
      "previousDraftVersion": "Integer",
      "newDraftVersion": "Integer",
      "previousRating": "Integer",
      "newRating": "Integer",
      "creationStage": "Text",
      "baseAllocationDelta": "Integer",
      "freebiePointDelta": "Integer",
      "remainingCategoryPoints": "Integer",
      "remainingFreebiePoints": "Integer",
      "createdInvalidations": "StructuredCollection",
      "resolvedInvalidations": "StructuredCollection",
      "validationSummary": "StructuredObject",
      "updatedAt": "Text"
    }
  },
  "failureContract": {
    "failureKey": "SetAbilityRatingFailure",
    "fields": {
      "operationId": "Reference",
      "characterId": "Reference",
      "abilityKey": "Reference",
      "errorKey": "Text",
      "errorArguments": "StructuredObject",
      "retryable": "Boolean",
      "failedAtStepKey": "Text"
    }
  },
  "recoveryPolicy": {
    "retryWithSameIdempotencyKey": true,
    "detectAlreadyCommittedOperation": true,
    "returnCommittedResultWhenDetected": true,
    "staleDraftRequiresReload": true,
    "repairMode": "explicit-recovery-operation-only"
  },
  "securityPolicy": {
    "rawSourceAccessRequired": false,
    "providerCallAllowed": false,
    "networkAccessAllowed": false,
    "filesystemAccess": "package-artifacts-read-only",
    "secretAccessAllowed": false
  },
  "events": [
    {
      "eventKey": "CharacterAbilityRatingChanged",
      "emittedAfterCommit": true,
      "payload": {
        "characterId": "Reference",
        "abilityKey": "Reference",
        "previousRating": "Integer",
        "newRating": "Integer",
        "creationStage": "Text",
        "draftVersion": "Integer",
        "operationId": "Reference",
        "updatedAt": "Text"
      }
    }
  ],
  "ambiguities": [
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.lupus-restricted-abilities",
      "severity": "high",
      "status": "semantic-review-required",
      "question": "May a Lupus purchase restricted Abilities with freebie points during initial Character creation?",
      "prototypeDecision": "Reject them during base allocation only; keep freebie behavior explicitly unresolved."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.freebie-limits",
      "severity": "high",
      "status": "semantic-review-required",
      "question": "May freebie points raise an Ability to 4 or 5 during Character creation?",
      "prototypeDecision": "Allow ratings up to 5 because the source summary explicitly distinguishes the base cap of 3 from freebie increases to 4 or 5."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.specialization.required-at-four",
      "severity": "high",
      "status": "semantic-review-required",
      "question": "Does reaching rating 4 require an immediate specialization selection?",
      "prototypeDecision": "No. It only enables specialization."
    }
  ],
  "source": {
    "sourceDocumentId": "source.werewolf3e.cleaned-ptbr",
    "sourceDocumentVersion": 1,
    "sourceFingerprint": "a4302e2938a137fb42d154c45decd43e02a19a2ba0eb3030b6eb1de942dab64a"
  },
  "review": {
    "sourceRuleDependency": "high-for-range-allocation-cap-restrictions-and-freebie-cost",
    "architectureConfidence": "high",
    "semanticReviewStatus": "pending",
    "implementationReviewStatus": "pending",
    "securityReviewStatus": "pending"
  },
  "prototypeNotes": [
    "This operation changes one persisted Ability rating at a time.",
    "Base allocation and freebie purchases remain separate ledger sources.",
    "The base-allocation cap is 3; freebie purchases may raise the rating to 4 or 5.",
    "Each freebie-purchased Ability dot costs two points.",
    "Reducing a rating refunds only freebie points that were actually purchased and recorded.",
    "Lupus restrictions are enforced against base allocation while freebie behavior remains explicitly unresolved.",
    "A reduction below rating 4 creates an explicit specialization invalidation rather than deleting player-authored data silently."
  ]
}
