        "willpower": null
      },
      "renown": {
        "glory": {
          "permanent": null,
          "temporary": null
        },
        "honor": {
          "permanent": null,
          "temporary": null
        },
        "wisdom": {
          "permanent": null,
          "temporary": null
        }
      },
      "gifts": {
        "initial": [],
        "acquired": []
      },
      "specializations": [],
      "metisDeformity": null
    },
    "workflow": {
      "profileKey": "character-creation.standard",
      "currentStageKey": "creation.identity",
      "pendingDependencyRecalculation": false,
      "invalidations": [],
      "warningAcknowledgements": []
    },
    "freebieBudget": {
      "total": 15,
      "spent": 0,
      "remaining": 15
    }
  },
  "transactionPolicy": {
    "transactionBoundary": "single-authoritative-commit",
    "partialCommitAllowed": false,
    "persistOperationRecord": true,
    "persistCharacterDraft": true,
    "persistCreationLedger": true,
    "persistValidationSummary": true
  },
  "resultContract": {
    "resultKey": "InitializeCharacterDraftResult",
    "fields": {
      "operationId": "Reference",
      "characterId": "Reference",
      "campaignId": "Reference",
      "characterSlotId": "Reference",
      "status": "Text",
      "currentStageKey": "Text",
      "packageBinding": "StructuredObject",
      "validationSummary": "StructuredObject",
      "creationLedgerId": "Reference",
      "createdAt": "Text"
    }
  },
  "failureContract": {
    "failureKey": "InitializeCharacterDraftFailure",
    "fields": {
      "operationId": "Reference",
      "errorKey": "Text",
      "errorArguments": "StructuredObject",
      "retryable": "Boolean",
      "existingCharacterId": "Reference",
      "failedAtStepKey": "Text"
    }
  },
  "recoveryPolicy": {
    "retryWithSameIdempotencyKey": true,
    "detectAlreadyCommittedOperation": true,
    "returnCommittedResultWhenDetected": true,
    "orphanedDraftDetection": true,
    "orphanedLedgerDetection": true,
    "repairMode": "explicit-recovery-operation-only"
  },
  "securityPolicy": {
    "rawSourceAccessRequired": false,
    "providerCallAllowed": false,
    "networkAccessAllowed": false,
    "filesystemAccess": "package-artifacts-read-only",
    "secretAccessAllowed": false
  },
  "events": [
    {
      "eventKey": "CharacterCreationDraftInitialized",
      "emittedAfterCommit": true,
      "payload": {
        "characterId": "Reference",
        "campaignId": "Reference",
        "packageId": "Text",
        "packageVersion": "Text",
        "creationProfileKey": "Text",
        "createdAt": "Text"
      }
    }
  ],
  "source": {
    "sourceDocumentId": "source.werewolf3e.cleaned-ptbr",
