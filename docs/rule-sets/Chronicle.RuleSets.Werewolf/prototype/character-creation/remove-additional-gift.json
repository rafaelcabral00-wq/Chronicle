  "ambiguities": [
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.additional-gift-refund",
      "severity": "low",
      "status": "implementation-decision-required",
      "question": "Should removing an additional Gift during an unfinished draft fully refund its freebie cost?",
      "prototypeDecision": "Yes, but only when the exact committed seven-point purchase can be identified and has not already been refunded."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.additional-gift-dependencies",
      "severity": "medium",
      "status": "future-design-required",
      "question": "How should removal behave if future creation content depends on the purchased Gift?",
      "prototypeDecision": "Block removal while active dependent state exists; do not cascade silently."
    }
  ],
