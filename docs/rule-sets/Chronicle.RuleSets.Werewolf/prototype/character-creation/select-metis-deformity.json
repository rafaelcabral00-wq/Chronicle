  "scope": "CharacterCreation",
  "authority": {
    "requestAuthority": "ChronicleApplication",
    "validationAuthority": "RuleSet",
    "commitAuthority": "Chronicle",
    "narratorMayRequest": false,
    "narratorMayExecute": false
  },
  "idempotency": {
    "required": true,
    "keyScope": "character-and-metis-deformity-selection",
    "sameKeySameInputReturnsPreviousResult": true,
    "sameKeyDifferentInputRejected": true
  },
  "inputContract": {
    "inputKey": "SelectMetisDeformityInput",
    "fields": [
      {
        "fieldKey": "characterId",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "draftVersion",
        "fieldType": "Integer",
        "required": true
      },
      {
        "fieldKey": "deformityKey",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "replaceExistingSelection",
        "fieldType": "Boolean",
        "required": true
      },
      {
        "fieldKey": "acknowledgedWarningKeys",
        "fieldType": "ReferenceCollection",
        "required": false
      },
      {
        "fieldKey": "operationId",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "idempotencyKey",
        "fieldType": "Text",
        "required": true
      }
    ]
  },
  "preconditions": [
    {
      "preconditionKey": "select-metis-deformity.character-is-draft",
      "requirement": {
        "entityType": "Character",
        "idField": "characterId",
        "field": "status",
        "operator": "equals",
        "value": "Draft"
      },
      "failureKey": "character-creation.select-metis-deformity.not-a-draft"
    },
    {
      "preconditionKey": "select-metis-deformity.draft-version-matches",
      "requirement": {
        "field": "draftVersion",
        "operator": "equals-current-character-version"
      },
      "failureKey": "character-creation.select-metis-deformity.stale-draft"
    },
    {
      "preconditionKey": "select-metis-deformity.character-is-metis",
      "requirement": {
        "field": "character.classification.race",
        "operator": "equals",
        "value": "character.race.metis"
      },
      "failureKey": "character-creation.select-metis-deformity.race-not-metis"
    },
    {
      "preconditionKey": "select-metis-deformity.catalog-available",
      "requirement": {
        "artifactRef": "../character-model/catalogs/metis-deformities.json",
        "operator": "readable-and-contract-compatible"
      },
      "failureKey": "character-creation.select-metis-deformity.catalog-unavailable"
    }
  ],
  "validationRules": [
    {
      "ruleKey": "select-metis-deformity.entry-valid",
      "ruleType": "catalog-membership",
      "severity": "blocking",
      "status": "candidate",
      "targetField": "deformityKey",
      "catalogRef": "../../character-model/catalogs/metis-deformities.json#entries",
      "errorKey": "character-creation.select-metis-deformity.invalid-entry"
    },
    {
      "ruleKey": "select-metis-deformity.entry-enabled",
      "ruleType": "catalog-property",
      "severity": "blocking",
      "status": "prototype",
      "targetField": "deformityKey",
      "catalogRef": "../../character-model/catalogs/metis-deformities.json#entries",
      "property": "enabled",
      "operator": "not-equals",
      "value": false,
      "errorKey": "character-creation.select-metis-deformity.entry-disabled"
    },
    {
      "ruleKey": "select-metis-deformity.exactly-one",
      "ruleType": "selection-quota",
      "severity": "blocking",
      "status": "candidate",
      "targetField": "character.metis-deformity",
      "maximum": 1,
      "replacementField": "replaceExistingSelection",
      "errorKey": "character-creation.select-metis-deformity.selection-already-exists"
    },
    {
      "ruleKey": "select-metis-deformity.replacement-explicit",
      "ruleType": "confirmation",
      "severity": "blocking",
      "status": "prototype",
      "appliesWhen": {
        "field": "character.metis-deformity",
        "operator": "exists"
      },
      "requirement": {
        "field": "replaceExistingSelection",
        "operator": "equals",
        "value": true
      },
      "errorKey": "character-creation.select-metis-deformity.replacement-not-confirmed"
    },
    {
      "ruleKey": "select-metis-deformity.warnings-acknowledged",
      "ruleType": "acknowledgement",
      "severity": "blocking",
      "status": "prototype",
      "source": "catalog-entry.warnings[]",
      "acknowledgementField": "acknowledgedWarningKeys",
      "errorKey": "character-creation.select-metis-deformity.warning-not-acknowledged"
    }
  ],
  "selectionPolicy": {
    "requiredWhenRace": "character.race.metis",
    "forbiddenWhenRaceIsNot": "character.race.metis",
    "minimumSelections": 1,
    "maximumSelections": 1,
    "replacementAllowed": true,
    "replacementRequiresExplicitFlag": true,
    "automaticRandomSelectionAllowed": false,
    "automaticNarratorSelectionAllowed": false,
    "userSelectionRequired": true
  },
