      "effects": [
        "validate-gift-exists",
        "validate-level-one",
        "validate-not-already-owned",
        "validate-freebie-budget"
      ]
    },
    {
      "order": 30,
      "stepKey": "resolve-explicit-eligibility",
      "executor": "RuleSet",
      "effects": [
        "validate-eligibility-source-type",
        "validate-eligibility-source-key",
        "resolve-matching-explicit-rule",
        "reject-unresolved-eligibility",
        "collect-review-warnings"
      ]
    },
    {
