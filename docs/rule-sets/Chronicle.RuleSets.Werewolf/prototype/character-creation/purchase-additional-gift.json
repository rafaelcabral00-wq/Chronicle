        "record-normalized-gift-identity",
        "record-gift-level",
        "record-acquisition-stage-creation-bonus-purchase",
        "record-eligibility-source",
        "record-acquired-by-operation-id",
        "set-status-owned-runtime-unavailable"
      ]
    },
    {
      "order": 50,
      "stepKey": "update-creation-ledger",
