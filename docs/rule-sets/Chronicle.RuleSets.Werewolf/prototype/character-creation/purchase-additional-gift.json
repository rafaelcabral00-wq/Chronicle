  "operationKind": "command",
  "scope": "CharacterCreation",
  "authority": {
    "requestAuthority": "ChronicleApplication",
    "validationAuthority": "RuleSet",
    "commitAuthority": "Chronicle",
    "narratorMayRequest": false,
    "narratorMayExecute": false
  },
  "idempotency": {
    "required": true,
    "keyScope": "character-and-additional-gift-purchase",
    "sameKeySameInputReturnsPreviousResult": true,
    "sameKeyDifferentInputRejected": true
  },
  "inputContract": {
    "inputKey": "PurchaseAdditionalGiftInput",
    "fields": [
      {
        "fieldKey": "characterId",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "draftVersion",
        "fieldType": "Integer",
        "required": true
      },
      {
        "fieldKey": "giftKey",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "eligibilitySourceType",
        "fieldType": "Text",
        "required": true,
        "allowedValues": [
          "race",
          "auspice",
          "tribe",
          "other-explicit-rule"
        ]
      },
      {
        "fieldKey": "eligibilitySourceKey",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "acknowledgedWarningKeys",
        "fieldType": "ReferenceCollection",
        "required": false
      },
      {
        "fieldKey": "operationId",
        "fieldType": "Reference",
        "required": true
      },
      {
        "fieldKey": "idempotencyKey",
        "fieldType": "Text",
        "required": true
      }
    ]
  },
  "preconditions": [
    {
      "preconditionKey": "purchase-additional-gift.character-is-draft",
      "requirement": {
        "entityType": "Character",
        "idField": "characterId",
        "field": "status",
        "operator": "equals",
        "value": "Draft"
      },
      "failureKey": "character-creation.purchase-additional-gift.not-a-draft"
    },
    {
      "preconditionKey": "purchase-additional-gift.draft-version-matches",
      "requirement": {
        "field": "draftVersion",
        "operator": "equals-current-character-version"
      },
      "failureKey": "character-creation.purchase-additional-gift.stale-draft"
    },
    {
      "preconditionKey": "purchase-additional-gift.catalog-available",
      "requirement": {
        "artifactRef": "../character-model/catalogs/initial-gifts.json",
        "operator": "readable-and-contract-compatible"
      },
      "failureKey": "character-creation.purchase-additional-gift.catalog-unavailable"
    },
    {
      "preconditionKey": "purchase-additional-gift.capability-enabled",
      "requirement": {
        "capabilityKey": "character-creation.purchase-additional-gift",
        "operator": "explicitly-enabled-by-reviewed-package-artifact"
      },
      "failureKey": "character-creation.purchase-additional-gift.capability-unavailable"
    }
  ],
  "validationRules": [
    {
      "ruleKey": "purchase-additional-gift.gift-valid",
      "ruleType": "catalog-membership",
      "severity": "blocking",
      "status": "candidate",
      "targetField": "giftKey",
      "catalogRef": "../../character-model/catalogs/initial-gifts.json#entries",
      "errorKey": "character-creation.purchase-additional-gift.invalid-gift"
    },
    {
      "ruleKey": "purchase-additional-gift.level-one-only",
      "ruleType": "catalog-property",
      "severity": "blocking",
      "status": "candidate",
      "targetField": "giftKey",
      "catalogRef": "../../character-model/catalogs/initial-gifts.json#entries",
      "property": "level",
      "operator": "equals",
      "value": 1,
      "errorKey": "character-creation.purchase-additional-gift.not-level-one"
    },
    {
      "ruleKey": "purchase-additional-gift.explicit-eligibility",
      "ruleType": "catalog-driven-eligibility",
      "severity": "blocking",
      "status": "blocked-pending-source-review",
      "targetField": "giftKey",
      "eligibilitySourceTypeField": "eligibilitySourceType",
      "eligibilitySourceKeyField": "eligibilitySourceKey",
      "requirement": {
        "operator": "gift-explicitly-eligible-from-current-character-state"
      },
      "errorKey": "character-creation.purchase-additional-gift.eligibility-unconfirmed"
    },
    {
      "ruleKey": "purchase-additional-gift.not-already-owned",
      "ruleType": "distinct-values",
      "severity": "blocking",
      "status": "prototype",
      "targetCollections": [
        "character.gifts.initial",
        "character.gifts.acquired"
      ],
      "identityResolution": "normalized-gift-identity",
      "includeProposedGift": true,
      "errorKey": "character-creation.purchase-additional-gift.already-owned"
    },
    {
      "ruleKey": "purchase-additional-gift.freebie-budget-available",
      "ruleType": "ledger-budget",
      "severity": "blocking",
      "status": "candidate",
      "ledgerRef": "character.creationLedger",
      "budgetKey": "character-creation.freebie-points",
      "cost": 7,
      "errorKey": "character-creation.purchase-additional-gift.insufficient-freebies"
    },
    {
      "ruleKey": "purchase-additional-gift.warnings-acknowledged",
      "ruleType": "acknowledgement",
      "severity": "blocking",
      "status": "prototype",
      "source": "eligibility-result.warnings[]",
      "acknowledgementField": "acknowledgedWarningKeys",
      "errorKey": "character-creation.purchase-additional-gift.warning-not-acknowledged"
    }
  ],
  "purchasePolicy": {
    "creationStage": "CreationBonusPurchase",
    "giftLevel": 1,
    "freebieCost": 7,
    "automaticEligibilityInferenceAllowed": false,
    "unrestrictedCatalogPurchaseAllowed": false,
    "initialGiftSlotConsumed": false,
    "maximumAdditionalGiftCount": 0,
    "capabilityReadiness": "blocked",
    "reason": "Current slice boundary keeps additional Gift purchase unavailable until eligibility is source-reviewed and promoted."
  },
  "eligibilityResolution": {
    "supportedCandidateSources": [
      {
        "sourceType": "race",
        "classificationField": "character.classification.race",
        "status": "source-review-required"
      },
      {
        "sourceType": "auspice",
        "classificationField": "character.classification.auspice",
        "status": "source-review-required"
      },
      {
        "sourceType": "tribe",
        "classificationField": "character.classification.tribe",
        "status": "source-review-required"
      },
      {
        "sourceType": "other-explicit-rule",
        "status": "future"
      }
    ],
    "mustReturn": [
      "isEligible",
      "eligibilitySourceType",
      "eligibilitySourceKey",
      "matchedRuleKey",
      "warnings"
    ],
    "defaultWhenUnresolved": "reject"
  },
  "mechanicalExecutionBoundary": {
    "persistOwnershipAllowed": false,
    "giftExecutionEnabled": false,
    "runtimeContractRef": "../../mechanics/gifts/execution.json",
    "runtimeReadiness": "blocked",
    "silentMechanicalApproximationAllowed": false
  },
  "executionPlan": [
    {
      "order": 10,
      "stepKey": "load-current-state",
