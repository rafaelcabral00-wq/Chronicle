      "question": "Do current Rage, Gnosis, and Willpower begin equal to their permanent ratings?",
      "prototypeDecision": "Initialize current equal to permanent, but retain this as a reversible prototype decision."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.resource-freebie-reconciliation",
      "severity": "high",
      "status": "semantic-review-required",
      "question": "When a freebie raises a permanent resource, does the current value increase by the same amount?",
      "prototypeDecision": "Increase both permanent and current values during Character creation."
    },
