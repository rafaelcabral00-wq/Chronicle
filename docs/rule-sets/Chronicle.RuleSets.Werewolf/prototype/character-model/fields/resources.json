          "maximumField": "character.resource.gnosis.permanent"
        },
        {
          "currentField": "character.resource.willpower.current",
          "maximumField": "character.resource.willpower.permanent"
        }
      ],
      "errorKey": "character.resource.current-above-permanent"
    },
