    {
      "ruleKey": "character.creation.abilities.race-restrictions",
      "ruleVersion": 1,
      "ruleType": "constraint",
      "status": "candidate",
      "lookupSource": "../catalogs/abilities.json#raceRestrictions",
      "errorKey": "character.creation.ability-race-restriction-violated"
    },
    {
      "ruleKey": "character.creation.abilities.specialization-rating",
      "ruleVersion": 1,
      "ruleType": "permission",
      "status": "candidate",
      "minimumRating": 4,
      "targetRef": "character.specializations",
      "errorKey": "character.creation.ability-specialization-rating-too-low"
