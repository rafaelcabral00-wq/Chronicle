    {
      "ruleKey": "character.creation.abilities.maximum-five",
      "ruleVersion": 1,
      "ruleType": "constraint",
      "status": "candidate",
      "maximum": 5,
      "targetPath": "character.abilities[].rating",
      "errorKey": "character.creation.ability-above-maximum"
