        "character-model.fields.gifts",
        "character-creation.operation-index"
      ],
      "readiness": "blocked",
      "blockingReason": "Additional creation-time Gift eligibility remains unresolved."
    }
  },
  "readinessPolicy": {
    "allowedValues": [
      "prototype-candidate",
      "candidate-partial",
      "blocked",
      "future"
    ],
    "requiredBlockedArtifactBehavior": "disable-dependent-capability",
    "optionalBlockedArtifactBehavior": "disable-dependent-optional-capability",
    "blockedArtifactsRemainDiscoverable": true,
    "partialArtifactsMustDeclareUnsupportedCapabilities": true
  },
  "contractValidation": {
    "validateOnPackageLoad": true,
    "validateArtifactKeys": true,
    "validateArtifactReferences": true,
    "validateContractVersions": true,
    "validateCatalogEntryKeys": true,
    "validateFieldKeys": true,
    "validateCatalogReferencesFromFields": true,
    "validateOperationReferences": true,
    "validateValidationRuleReferences": true,
    "validateInvalidationReferences": true,
    "validateWarningReferences": true,
    "validateSheetFieldReferences": true,
    "validateDependencyGraphsAcyclic": true,
    "validateSecurityDeclarations": true
  },
  "consistencyRules": [
    {
      "ruleKey": "character-model-index.artifact-keys-unique",
      "severity": "blocking",
      "requirement": "every indexed artifact key is unique"
    },
    {
      "ruleKey": "character-model-index.refs-resolve",
      "severity": "blocking",
      "requirement": "every artifact reference resolves inside the Rule Set package"
    },
    {
      "ruleKey": "character-model-index.catalog-entry-keys-unique",
      "severity": "blocking",
      "requirement": "catalog entry keys are unique within their catalogs"
    },
    {
      "ruleKey": "character-model-index.field-keys-unique",
      "severity": "blocking",
      "requirement": "field keys are unique across indexed field artifacts"
    },
    {
      "ruleKey": "character-model-index.field-catalog-refs-valid",
      "severity": "blocking",
      "requirement": "all field catalog references resolve to known catalog entries"
    },
    {
      "ruleKey": "character-model-index.creation-index-valid",
      "severity": "blocking",
      "requirement": "the Character creation model index loads successfully"
    },
    {
      "ruleKey": "character-model-index.validation-index-valid",
      "severity": "blocking",
      "requirement": "the Character validation index loads successfully"
    },
    {
      "ruleKey": "character-model-index.operation-index-valid",
      "severity": "blocking",
      "requirement": "the Character creation operation index loads successfully"
    },
    {
      "ruleKey": "character-model-index.sheet-refs-valid",
      "severity": "blocking",
      "requirement": "all default Character sheet references resolve to indexed Character model fields"
    }
  ],
  "fingerprintPolicy": {
    "indexFingerprintRequired": true,
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "includeArtifactFingerprints": true,
    "includeReadiness": true,
    "includeDependencyMetadata": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncluded": false
  },
  "diagnosticProjection": {
    "include": [
      "artifactKey",
      "artifactRef",
      "artifactRole",
      "required",
      "readiness",
      "contractVersion",
      "artifactVersion",
      "dependencyStatus",
      "referenceStatus",
      "fingerprintStatus"
    ],
    "developerDetailsOnlyInDeveloperMode": true,
    "rawCharacterStateIncluded": false,
    "rawSourceTextIncluded": false
  },
  "migrationPolicy": {
    "modelVersionBoundToCharacter": true,
    "historicalCompletionSnapshotsRemainUnchanged": true,
    "migrationRequiresExplicitOperation": true,
    "automaticSemanticMigrationAllowed": false,
    "migrationMustValidateSourceAndTargetIndexes": true,
    "migrationMustRecordBeforeAndAfterFingerprints": true
  },
  "securityPolicy": {
    "networkAccessRequired": false,
    "filesystemAccess": "package-artifacts-read-only",
    "containsNarrativePayload": false,
    "ordinaryLogsMayContain": [
      "artifactKeys",
      "artifactRefs",
      "readiness",
      "contractVersions",
      "fingerprints",
      "diagnosticKeys"
    ],
    "ordinaryLogsMustExclude": [
      "raw-character-state",
      "raw-narrative-text",
      "sourcebook-text",
      "provider-secrets"
    ]
  },
  "serializationPolicy": {
    "canonicalFormat": "JSON",
    "canonicalPropertyOrderingRequiredForFingerprint": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncludedInFingerprint": false
  },
