  "loadPolicy": {
    "loadMode": "manifest-driven",
    "loadSequence": [
      "modelRoot",
      "catalogArtifacts",
      "fieldArtifacts",
      "submodelIndexes",
      "externalArtifacts"
    ],
    "sortBy": "loadOrder",
    "duplicateArtifactKeyBehavior": "package-load-failure",
    "missingRequiredArtifactBehavior": "disable-character-model-capability",
    "unsupportedContractVersionBehavior": "package-load-failure",
    "artifactOutsidePackageRootAllowed": false,
    "networkResolutionAllowed": false,
    "hardcodedFallbackAllowed": false
  },
  "dependencyPolicy": {
    "allDeclaredDependenciesMustResolve": true,
    "cyclesAllowed": false,
    "cycleBehavior": "package-load-failure-with-cycle-path",
    "loadOrderMustRespectDependencies": true,
    "fieldArtifactsMayDependOnCatalogArtifacts": true,
    "submodelIndexesMayDependOnFieldsAndCatalogs": true
  },
  "capabilityMap": {
    "character-model.core": {
      "requiredArtifacts": [
        "character-model.root",
        "character-model.fields.identity",
        "character-model.fields.classification",
        "character-model.fields.attributes",
        "character-model.fields.abilities",
        "character-model.fields.backgrounds",
        "character-model.fields.gifts",
        "character-model.fields.renown-and-rank",
        "character-model.fields.resources",
        "character-model.fields.specializations",
        "character-model.fields.narrative"
      ]
    },
    "character-model.creation": {
      "requiredArtifacts": [
        "character-creation.creation-model-index",
        "character-creation.operation-index"
      ]
    },
    "character-model.validation": {
      "requiredArtifacts": [
        "character-model.validation-index"
      ]
    },
    "character-model.sheet": {
      "requiredArtifacts": [
        "character-sheet.default"
      ]
    },
    "character-model.additional-gift-purchase": {
