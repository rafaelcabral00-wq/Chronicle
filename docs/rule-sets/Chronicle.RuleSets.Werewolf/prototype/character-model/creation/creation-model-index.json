{
  "contractVersion": 1,
  "artifactKey": "character-creation.creation-model-index",
  "artifactVersion": "0.1.0-prototype",
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "character-creation.creation-model-index.display-name",
  "publicationStatus": "prototype-candidate",
  "scope": "CharacterCreation",
  "purpose": [
    "Provide the canonical discovery surface for Character creation model artifacts.",
    "Index the creation profile, dependency graph, invalidations, stage-state projection, creation ledger, completion snapshot, review summary, and warning acknowledgements.",
    "Enable deterministic loading, diagnostics, and validation of creation-model contracts without hardcoded Werewolf-specific registration.",
    "Preserve hierarchical ownership from character-model-index to creation-model-index to creation artifacts."
  ],
  "authority": {
    "indexDefinitionAuthority": "RuleSetPackage",
    "artifactDiscoveryAuthority": "Chronicle",
    "artifactContractValidationAuthority": "Chronicle",
    "mechanicalInterpretationAuthority": "RuleSet",
    "persistenceAuthority": "Chronicle",
    "hardcodedWerewolfRegistrationAllowed": false
  },
  "parentBindings": {
    "parentArtifactKey": "character-model.character-model-index",
    "parentArtifactRef": "../character-model-index.json",
    "indexedAsSubmodelArtifactKey": "character-creation.creation-model-index",
    "indexedAsSubmodelRole": "character-creation",
    "requiredByParent": true
  },
  "artifactGroups": [
    {
      "groupKey": "creation-structure",
      "description": "Structure and dependency contracts for staged creation.",
      "artifactKeys": [
        "character-creation.profile",
        "character-creation.dependency-graph",
        "character-creation.invalidations",
        "werewolf-prototype.character-creation-stage-state"
      ]
    },
    {
      "groupKey": "creation-state-and-review",
      "description": "State, summary, acknowledgement, and snapshot contracts for deterministic review and completion.",
      "artifactKeys": [
        "character-creation.creation-ledger",
        "character-creation.completion-snapshot",
        "character-creation.review-summary",
        "character-creation.warning-acknowledgements"
      ]
    }
  ],
  "creationArtifacts": [
    {
      "artifactKey": "character-creation.profile",
      "artifactRef": "./profile.json",
      "artifactRole": "creation-profile",
      "loadOrder": 10,
      "required": true,
      "readiness": "prototype-candidate"
    },
    {
      "artifactKey": "character-creation.dependency-graph",
      "artifactRef": "./dependency-graph.json",
      "artifactRole": "creation-dependency-graph",
      "loadOrder": 20,
      "required": true,
      "readiness": "prototype-candidate",
      "dependsOn": [
        "character-creation.profile"
      ]
    },
    {
      "artifactKey": "character-creation.invalidations",
      "artifactRef": "./invalidations.json",
      "artifactRole": "creation-invalidations",
      "loadOrder": 30,
      "required": true,
      "readiness": "prototype-candidate",
      "dependsOn": [
        "character-creation.dependency-graph"
      ]
    },
    {
      "artifactKey": "werewolf-prototype.character-creation-stage-state",
      "artifactRef": "./stage-state.json",
      "artifactRole": "creation-stage-state",
      "loadOrder": 40,
      "required": true,
      "readiness": "prototype-candidate",
      "dependsOn": [
        "character-creation.profile",
        "character-creation.dependency-graph",
        "character-creation.invalidations",
        "character-creation.creation-ledger",
        "character-creation.warning-acknowledgements"
      ],
