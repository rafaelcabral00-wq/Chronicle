      "artifactRef": "./completion-snapshot.json",
      "artifactRole": "completion-snapshot",
      "loadOrder": 60,
      "required": true,
      "readiness": "prototype-candidate",
      "dependsOn": [
        "character-creation.creation-ledger",
        "character-creation.review-summary",
        "character-creation.warning-acknowledgements"
      ]
    },
    {
      "artifactKey": "character-creation.review-summary",
      "artifactRef": "./review-summary.json",
      "artifactRole": "creation-review-summary",
      "loadOrder": 70,
      "required": true,
      "readiness": "prototype-candidate",
      "dependsOn": [
        "werewolf-prototype.character-creation-stage-state",
        "character-creation.creation-ledger",
        "character-creation.invalidations",
        "character-creation.warning-acknowledgements"
      ]
    },
    {
      "artifactKey": "character-creation.warning-acknowledgements",
      "artifactRef": "./warning-acknowledgements.json",
      "artifactRole": "warning-acknowledgements",
      "loadOrder": 80,
      "required": true,
      "readiness": "prototype-candidate"
    }
