  "requiredArtifactRefs": [
    "./profile.json",
    "./dependency-graph.json",
    "./invalidations.json",
    "./stage-state.json",
    "./creation-ledger.json",
    "./completion-snapshot.json",
    "./review-summary.json",
    "./warning-acknowledgements.json"
  ],
  "externalDependencies": [
    {
      "artifactKey": "character-creation.operation-index",
      "artifactRef": "../../character-creation/operation-index.json",
      "required": true
    },
    {
      "artifactKey": "character-model.validation-index",
      "artifactRef": "../validation/validation-index.json",
      "required": true
    }
  ],
  "artifactCountSummary": {
    "indexedArtifactCount": 8,
    "requiredArtifactCount": 8,
    "optionalArtifactCount": 0,
    "groupCount": 2
  },
  "discoveryPolicy": {
    "manifestDriven": true,
    "hardcodedArtifactRegistrationAllowed": false,
    "artifactKeysMustBeUnique": true,
    "artifactRefsMustResolveInsidePackage": true,
    "contractVersionMustBeSupported": true,
    "compatibilityArtifactKeysAllowed": true
  },
  "loadPolicy": {
    "loadMode": "manifest-driven",
    "sortBy": "loadOrder",
    "duplicateArtifactKeyBehavior": "package-load-failure",
    "missingRequiredArtifactBehavior": "disable-character-creation-capability",
    "unsupportedContractVersionBehavior": "package-load-failure",
    "artifactOutsidePackageRootAllowed": false,
    "networkResolutionAllowed": false,
    "hardcodedFallbackAllowed": false
  },
  "consistencyRules": [
    {
      "ruleKey": "creation-model-index.artifact-keys-unique",
      "severity": "blocking",
      "requirement": "every indexed creation artifact key is unique"
    },
    {
      "ruleKey": "creation-model-index.refs-resolve",
      "severity": "blocking",
      "requirement": "every required creation artifact reference resolves relative to this index"
    },
    {
      "ruleKey": "creation-model-index.required-refs-complete",
      "severity": "blocking",
      "requirement": "requiredArtifactRefs contains exactly the indexed required creation artifacts"
    },
    {
      "ruleKey": "creation-model-index.parent-binding-valid",
      "severity": "blocking",
      "requirement": "parent binding resolves and is indexed by character-model.character-model-index"
    },
    {
      "ruleKey": "creation-model-index.dependency-graph-acyclic",
      "severity": "blocking",
      "requirement": "declared artifact dependencies are acyclic"
    }
  ],
  "fingerprintPolicy": {
    "indexFingerprintRequired": true,
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "includeArtifactFingerprints": true,
    "includeDependencyFingerprints": true,
    "includeReadiness": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncluded": false
  },
  "diagnosticProjection": {
    "include": [
      "artifactKey",
      "artifactRef",
      "artifactRole",
      "required",
      "readiness",
      "dependencyStatus",
      "referenceStatus",
      "fingerprintStatus"
    ],
    "developerDetailsOnlyInDeveloperMode": true,
    "rawCharacterStateIncluded": false,
    "rawNarrativeTextIncluded": false,
    "sourcebookTextIncluded": false
  },
  "securityPolicy": {
    "networkAccessRequired": false,
    "filesystemAccess": "package-artifacts-read-only",
    "containsNarrativePayload": false,
    "containsProviderSecrets": false,
    "ordinaryLogsMayContain": [
      "artifactKeys",
      "artifactRefs",
      "readiness",
      "contractVersions",
      "diagnosticKeys",
      "fingerprints"
    ],
    "ordinaryLogsMustExclude": [
      "raw-character-state",
      "raw-narrative-text",
      "sourcebook-text",
      "provider-secrets"
    ]
  },
  "serializationPolicy": {
    "canonicalFormat": "JSON",
    "canonicalPropertyOrderingRequiredForFingerprint": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncludedInFingerprint": false
  },
  "review": {
    "sourceRuleDependency": "indirect-through-indexed-creation-artifacts",
    "architectureConfidence": "high",
    "semanticReviewStatus": "pending",
    "implementationReviewStatus": "pending",
    "contractConsistencyReviewStatus": "pending",
    "securityReviewStatus": "pending"
  },
  "prototypeNotes": [
    "This index canonically owns creation-model artifact discovery for the current prototype slice.",
    "Discovery remains package-driven and hierarchical under character-model.character-model-index.",
    "No creation mechanics are changed by this index; it only declares ownership, discovery, and consistency contracts.",
    "Additional gift purchase and runtime gift effects remain blocked or excluded by referenced creation artifacts."
  ]
}