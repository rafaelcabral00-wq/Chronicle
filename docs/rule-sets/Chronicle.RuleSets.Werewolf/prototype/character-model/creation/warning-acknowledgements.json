      ],
      "allowedOperationKeys": [
        "character-creation.set-resource-rating",
        "character-creation.apply-classification-change",
        "character-creation.complete-character"
      ]
    },
    {
      "warningKey": "character-creation.warning.classification-change-preserves-dependent-state",
      "messageKey": "character-creation.warning.classification-change-preserves-dependent-state",
      "severity": "warning",
      "acknowledgementRequired": true,
      "acknowledgementScope": "completion-attempt",
      "reconfirmationPolicy": "completion-attempt-only",
      "expirationDependencies": [
        "character.version",
        "classification-change.previewFingerprint"
      ],
      "allowedOperationKeys": [
        "character-creation.apply-classification-change"
      ]
    },
    {
      "warningKey": "character-creation.warning.narrator-suggestion-edited-before-acceptance",
      "messageKey": "character-creation.warning.narrator-suggestion-edited-before-acceptance",
      "severity": "warning",
      "acknowledgementRequired": false,
      "acknowledgementScope": "warning-instance",
      "reconfirmationPolicy": "never-reuse",
      "expirationDependencies": [
        "suggestionId",
        "acceptedValueFingerprint"
      ],
      "allowedOperationKeys": [
        "character-creation.set-narrative-field",
        "character-creation.add-character-goal",
        "character-creation.update-character-goal",
        "character-creation.add-character-relationship",
        "character-creation.update-character-relationship"
      ]
    },
    {
      "warningKey": "character-creation.warning.unspent-freebie-points",
      "messageKey": "character-creation.warning.unspent-freebie-points",
      "severity": "warning",
      "acknowledgementRequired": true,
      "acknowledgementScope": "completion-attempt",
      "reconfirmationPolicy": "completion-attempt-only",
      "expirationDependencies": [
        "character.version",
        "character.creationLedger.freebiePointsRemaining"
      ],
      "allowedOperationKeys": [
        "character-creation.complete-character"
      ]
    }
  ],
  "creationPolicy": {
    "onlyKnownWarningKeysAllowed": true,
    "warningInstanceFingerprintRequired": true,
    "messageArgumentsFingerprintRequired": true,
    "userIdentityRequired": true,
    "acknowledgedAtRequired": true,
    "acknowledgedInOperationIdRequired": true,
    "characterVersionRequired": true,
    "packageBindingRequired": true,
    "persistInsideAuthorizingTransaction": true,
    "duplicateActiveAcknowledgementPolicy": "return-existing-when-same-instance"
  },
  "matchingPolicy": {
    "requiredMatchFields": [
      "warningKey",
      "warningInstanceFingerprint",
      "characterId",
      "packageBinding"
    ],
    "scopeSpecificMatch": {
      "warning-instance": [
        "warningInstanceFingerprint"
      ],
      "field-value": [
        "scopeRef",
        "expirationDependencies"
      ],
      "selection": [
        "scopeRef",
        "expirationDependencies"
      ],
      "creation-draft": [
        "characterId",
        "expirationDependencies"
      ],
      "completion-attempt": [
        "characterVersionAtAcknowledgement",
        "acknowledgedInOperationId"
      ]
    },
    "crossPackageReuseAllowed": false,
    "crossCharacterReuseAllowed": false
  },
  "expirationPolicy": {
    "evaluateBeforeEveryReuse": true,
    "evaluateDuringFreshValidation": true,
    "evaluateInsideCompletionTransaction": true,
    "expireWhen": [
      "warning-instance-fingerprint-changed",
      "declared-dependency-changed",
      "character-version-changed-for-completion-attempt",
      "package-binding-changed",
      "warning-definition-changed-incompatibly",
      "acknowledgement-revoked"
    ],
    "expirationMutation": "append-status-transition-record",
    "silentReactivationAllowed": false
  },
  "revocationPolicy": {
    "userMayRevoke": true,
    "chronicleMayRevokeOnIntegrityFailure": true,
    "ruleSetMayProposeRevocation": true,
    "narratorMayRevoke": false,
    "chronicleDirectorMayRevoke": false,
    "revocationRequiresOperationId": true,
    "revokedItemRetained": true
  },
  "relationshipToValidation": {
    "acknowledgementChangesWarningSeverity": false,
    "acknowledgementMakesInvalidStateValid": false,
    "acknowledgementResolvesInvalidation": false,
    "acknowledgementMayAuthorizeProceedingPastAcknowledgementRequiredWarning": true,
    "blockingOrErrorRulesRemainUnbypassable": true,
    "freshValidationStillRequiredAtCompletion": true
  },
  "executionPolicy": {
    "operationsMayAcceptAcknowledgedWarningKeys": true,
    "chronicleResolvesKeysToActiveAcknowledgements": true,
    "ruleSetVerifiesWarningInstanceMatch": true,
    "chroniclePersistsNewAcknowledgements": true,
    "operationFailsWhenRequiredAcknowledgementMissing": true,
    "operationFailsWhenAcknowledgementExpired": true,
    "rawWarningMessageNotRequiredForPersistence": true
  },
  "completionPolicy": {
    "completionConsumesAttemptOnlyAcknowledgements": true,
    "reusableAcknowledgementsRemainActiveAfterCompletion": true,
    "completionSnapshotIncludes": [
      "warningKey",
      "warningInstanceFingerprint",
      "acknowledgementId",
      "acknowledgedAt",
      "acknowledgedByUserId",
      "packageBinding"
    ],
    "completionSnapshotExcludes": [
      "raw-narrative-text",
      "provider-secrets",
      "sourcebook-text"
    ]
  },
  "integrityRules": [
    {
      "ruleKey": "warning-acknowledgements.id-unique",
      "severity": "blocking",
      "requirement": "acknowledgementId is unique for the Character"
    },
    {
      "ruleKey": "warning-acknowledgements.warning-key-known",
      "severity": "blocking",
      "requirement": "every warningKey exists in this artifact or another reviewed package warning artifact"
    },
    {
      "ruleKey": "warning-acknowledgements.user-present",
      "severity": "blocking",
      "requirement": "every active acknowledgement records the user who accepted it"
    },
    {
      "ruleKey": "warning-acknowledgements.fingerprint-valid",
      "severity": "blocking",
      "requirement": "item and collection fingerprints recompute successfully"
    },
    {
      "ruleKey": "warning-acknowledgements.scope-valid",
      "severity": "blocking",
      "requirement": "scope and scopeRef satisfy the warning definition"
    },
    {
      "ruleKey": "warning-acknowledgements.expiration-state-valid",
      "severity": "blocking",
      "requirement": "no active acknowledgement has an unmet expiration dependency"
    }
  ],
  "recoveryPolicy": {
    "automaticRepairAllowed": false,
    "rebuildActiveSetAllowed": true,
    "rebuildSource": [
      "acknowledgement-history",
      "character-versions",
      "package-bindings",
      "warning-instance-fingerprints"
    ],
    "rebuildOutputIsDiagnosticUntilAuditedCommit": true,
    "repairRequires": [
      "explicit-recovery-operation",
      "before-and-after-fingerprints",
      "audited-reason"
    ]
  },
  "securityPolicy": {
    "encryptedAtRest": true,
    "userIdentityStored": true,
    "rawNarrativeTextStored": false,
    "rawWarningArgumentsStored": false,
    "ordinaryLogsMayContain": [
      "characterId",
      "acknowledgementId",
      "warningKey",
      "status",
      "operationId",
      "fingerprints"
    ],
    "ordinaryLogsMustExclude": [
      "raw-narrative-text",
      "provider-secrets",
      "sourcebook-text",
      "raw-warning-message-arguments"
    ],
    "networkAccessRequired": false
  },
  "serializationPolicy": {
    "canonicalFormat": "JSON",
    "canonicalPropertyOrderingRequiredForFingerprint": true,
    "unicodeNormalization": "NFC",
    "timestampFormat": "RFC3339-UTC",
    "nullFieldsIncludedInFingerprint": false
  },
