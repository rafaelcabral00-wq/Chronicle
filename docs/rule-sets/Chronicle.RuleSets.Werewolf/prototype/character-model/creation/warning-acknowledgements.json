{
  "contractVersion": 1,
  "artifactKey": "character-creation.warning-acknowledgements",
  "artifactVersion": "0.1.0-prototype",
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "character-creation.warning-acknowledgements.display-name",
  "publicationStatus": "prototype-candidate",
  "scope": "CharacterCreation",
  "purpose": [
    "Represent warnings that require explicit user acknowledgement before a creation operation or Character completion may proceed.",
    "Separate acknowledgement from validation success and from invalidation resolution.",
    "Preserve an auditable record of what the user accepted, under which Character version and Rule Set package binding.",
    "Prevent the Narrator or Chronicle Director from silently accepting warnings on the user's behalf."
  ],
  "authority": {
    "warningDefinitionAuthority": "RuleSet",
    "acknowledgementPersistenceAuthority": "Chronicle",
    "acknowledgementAuthority": "User",
    "narratorMayAcknowledge": false,
    "chronicleDirectorMayAcknowledge": false,
    "automaticAcknowledgementAllowed": false
  },
  "collectionShape": {
    "characterId": "Reference",
    "draftVersion": "Integer",
    "items": "WarningAcknowledgementCollection",
    "activeAcknowledgementCount": "Integer",
    "contentFingerprint": "Text",
    "updatedAt": "Text"
  },
  "itemShape": {
    "acknowledgementId": "Reference",
    "warningKey": "Reference",
    "warningInstanceFingerprint": "Text",
    "status": "Text",
    "acknowledgedAt": "Text",
    "acknowledgedBy": "Text",
    "acknowledgedByUserId": "Reference",
    "acknowledgedInOperationId": "Reference",
    "characterVersionAtAcknowledgement": "Integer",
    "packageBinding": "StructuredObject",
    "messageKey": "Reference",
    "messageArgumentsFingerprint": "Text",
    "scope": "Text",
    "scopeRef": "Reference",
    "expiresWhen": "StructuredObject",
    "revokedAt": "Text",
    "revokedByOperationId": "Reference",
    "supersededByAcknowledgementId": "Reference",
    "ruleRefs": "ReferenceCollection",
    "metadata": "StructuredObject",
    "itemFingerprint": "Text"
  },
  "statusPolicy": {
    "allowedStatuses": [
      "active",
      "expired",
      "revoked",
      "superseded"
    ],
    "initialStatus": "active",
    "activeMayAuthorizeWarningAcceptance": true,
    "expiredMayAuthorizeWarningAcceptance": false,
    "revokedMayAuthorizeWarningAcceptance": false,
    "supersededMayAuthorizeWarningAcceptance": false,
    "hardDeleteAllowed": false
  },
  "warningDefinitionShape": {
    "warningKey": "Reference",
    "messageKey": "Reference",
    "severity": "Text",
    "acknowledgementRequired": "Boolean",
    "acknowledgementScope": "Text",
    "reconfirmationPolicy": "Text",
    "expirationDependencies": "ReferenceCollection",
    "allowedOperationKeys": "ReferenceCollection",
    "ruleRefs": "ReferenceCollection"
  },
  "acknowledgementScopes": [
    {
      "scope": "warning-instance",
      "description": "Valid only for the exact warning instance fingerprint."
    },
    {
      "scope": "field-value",
      "description": "Valid while the relevant Character field value remains unchanged."
    },
    {
      "scope": "selection",
      "description": "Valid while the selected item and its eligibility context remain unchanged."
    },
    {
      "scope": "creation-draft",
      "description": "Valid for the current Character draft until an expiration dependency changes."
    },
    {
      "scope": "completion-attempt",
      "description": "Valid only for one completion request and the exact validated draft version."
    }
  ],
  "reconfirmationPolicies": [
    {
      "policy": "never-reuse",
      "behavior": "A new warning instance always requires a new acknowledgement."
    },
    {
      "policy": "reuse-while-fingerprint-matches",
      "behavior": "An active acknowledgement is reusable only while the warning instance fingerprint matches."
    },
    {
      "policy": "reuse-while-dependencies-match",
      "behavior": "An active acknowledgement is reusable while all declared dependency values and package binding remain unchanged."
    },
    {
      "policy": "completion-attempt-only",
      "behavior": "Acknowledgement expires after the completion attempt succeeds, fails, or the draft version changes."
    }
  ],
  "warningDefinitions": [
    {
      "warningKey": "character-creation.warning.prototype-rule-in-use",
      "messageKey": "character-creation.warning.prototype-rule-in-use",
      "severity": "warning",
      "acknowledgementRequired": true,
      "acknowledgementScope": "creation-draft",
      "reconfirmationPolicy": "reuse-while-dependencies-match",
      "expirationDependencies": [
        "character.ruleSetBinding.packageVersion",
        "character.creation.prototypeDecisionRefs"
      ],
      "allowedOperationKeys": [
        "character-creation.complete-character"
      ]
    },
    {
      "warningKey": "character-creation.warning.source-ambiguity-accepted",
      "messageKey": "character-creation.warning.source-ambiguity-accepted",
      "severity": "warning",
      "acknowledgementRequired": true,
      "acknowledgementScope": "warning-instance",
      "reconfirmationPolicy": "reuse-while-fingerprint-matches",
      "expirationDependencies": [
        "warning.ruleRefs",
        "warning.ambiguityRefs",
