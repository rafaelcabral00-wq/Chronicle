  "dependencyImpactPolicy": {
    "previewBeforeDestructiveChangePreferred": true,
    "silentCascadeAllowed": false,
    "derivedFieldRecalculationAllowedWhenDeterministic": true,
    "userSelectionReplacementAllowedAutomatically": false,
    "manualReviewRequiredForAmbiguousImpact": true,
    "classificationChangeOperationMustReturn": [
