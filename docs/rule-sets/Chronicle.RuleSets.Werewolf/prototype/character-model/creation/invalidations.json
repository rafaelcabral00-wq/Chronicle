      "messageKey": "character-creation.invalidation.freebie-budget-overspent",
      "trigger": "freebie purchases exceed the fifteen-point budget",
      "requiredResolutionType": "refund-or-reallocate",
      "candidateResolutionOperationKeys": [
        "character-creation.set-attribute-rating",
