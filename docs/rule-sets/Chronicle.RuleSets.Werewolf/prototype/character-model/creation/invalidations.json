      "resolvedInvalidations",
      "preservedSelections",
      "recalculatedDerivedValues"
    ]
  },
  "completionPolicy": {
    "openBlockingItemsAllowed": false,
    "openErrorItemsAllowed": false,
    "openWarningsAllowedOnlyWhenCompletionRulePermitsAcknowledgement": true,
    "freshValidationMustReconcileInvalidationCollection": true,
    "completionOperationMayNotDeleteInvalidations": true
