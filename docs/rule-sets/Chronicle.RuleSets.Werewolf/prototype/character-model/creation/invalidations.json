    "groupByCategory": true,
    "showAffectedStage": true,
    "showAllowedResolutionActions": true,
    "showTechnicalRuleRefsInDeveloperMode": true,
    "showRawNarrativeContent": false
  },
  "integrityRules": [
    {
      "ruleKey": "character-creation.invalidations.id-unique",
      "severity": "blocking",
      "requirement": "invalidationId is unique for the Character"
    },
    {
      "ruleKey": "character-creation.invalidations.key-known",
      "severity": "blocking",
      "requirement": "every invalidationKey exists in this artifact"
    },
    {
      "ruleKey": "character-creation.invalidations.owner-operation-present",
      "severity": "blocking",
      "requirement": "every item references the operation responsible for maintaining it"
    },
    {
      "ruleKey": "character-creation.invalidations.resolution-audited",
      "severity": "blocking",
      "requirement": "resolved items contain resolvedAt and resolvedByOperationId"
    },
    {
      "ruleKey": "character-creation.invalidations.open-count-reconciles",
      "severity": "blocking",
      "requirement": "stored summary counts equal deterministic counts from items"
    },
    {
      "ruleKey": "character-creation.invalidations.fingerprint-valid",
      "severity": "blocking",
      "requirement": "item and collection fingerprints recompute successfully"
