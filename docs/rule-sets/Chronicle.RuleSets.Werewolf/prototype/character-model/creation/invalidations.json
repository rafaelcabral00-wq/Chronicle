      "category": "workflow",
      "defaultSeverity": "warning",
      "messageKey": "character-creation.invalidation.stage-review-required",
      "trigger": "an upstream change affects a previously completed creation stage without proving it invalid",
      "requiredResolutionType": "explicit-review",
      "candidateResolutionOperationKeys": [
        "character-creation.validate-character"
      ]
    }
  ],
  "creationPolicy": {
    "createOnlyFromExplicitRule": true,
    "freeTextInvalidationKeysAllowed": false,
    "duplicateOpenItemPolicy": "merge-causes-and-affected-references",
    "stableIdentityComponents": [
