    "resolutionPersistedInsideRepairTransaction": true,
    "resolvedItemRetained": true,
    "reopenBehavior": "create-new-item-and-reference-previous-item",
    "automaticResolutionCases": [
      "required-selection-now-present-and-valid",
      "dependent-selection-cleared-by-authorized-operation",
      "budget-reconciles-after-authorized-refund",
      "specialization-parent-rating-restored",
      "resource-state-recalculated-and-valid"
