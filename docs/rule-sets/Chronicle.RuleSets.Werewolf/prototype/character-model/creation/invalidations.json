  "statusPolicy": {
    "allowedStatuses": [
      "open",
      "resolved",
      "superseded"
    ],
    "initialStatus": "open",
    "openBlocksCompletionWhenSeverity": [
      "blocking",
      "error"
    ],
    "resolvedItemsRemainAuditable": true,
    "hardDeleteAllowed": false,
    "automaticResolutionAllowed": "only-when-the-owning-rule-can-prove-consistency"
  },
  "severityPolicy": {
    "allowedSeverities": [
      "blocking",
      "error",
      "warning",
      "information"
    ],
    "completionBehavior": {
      "blocking": "completion-forbidden",
      "error": "completion-forbidden",
      "warning": "acknowledgement-may-be-required",
      "information": "does-not-block"
    }
  },
  "categories": [
    {
      "category": "classification-dependency",
      "description": "A classification change invalidated a derived value or dependent selection."
    },
    {
      "category": "allocation-overflow",
      "description": "A rating or allocation no longer fits its current creation-stage limit or budget."
    },
    {
      "category": "selection-eligibility",
      "description": "A selected item is no longer eligible from the current Character state."
    },
    {
      "category": "required-selection-missing",
      "description": "A required slot or conditional choice is currently empty."
    },
    {
      "category": "specialization-validity",
      "description": "A specialization is attached to a rating that no longer qualifies."
    },
    {
      "category": "resource-reconciliation",
      "description": "A classification-derived Resource value requires review or recalculation."
    },
    {
      "category": "ledger-integrity",
      "description": "The creation ledger and Character state no longer reconcile."
    },
    {
      "category": "package-binding",
      "description": "The Character draft no longer matches the installed Rule Set package binding."
    },
    {
      "category": "workflow",
      "description": "A creation step must be repeated or explicitly reviewed."
    }
  ],
  "invalidationDefinitions": [
    {
      "invalidationKey": "character-creation.classification-dependent-state-review-required",
      "category": "classification-dependency",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.classification-dependent-state-review-required",
      "trigger": "a Race, Auspice, or Tribe change affects derived or eligible state",
      "requiredResolutionType": "review-and-apply",
      "candidateResolutionOperationKeys": [
        "character-creation.preview-classification-change",
        "character-creation.apply-classification-change"
      ]
    },
    {
      "invalidationKey": "character-creation.initial-gift-no-longer-eligible",
      "category": "selection-eligibility",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.initial-gift-no-longer-eligible",
      "trigger": "a selected initial Gift no longer matches its Race, Auspice, or Tribe slot",
      "requiredResolutionType": "replace-selection",
      "candidateResolutionOperationKeys": [
        "character-creation.select-initial-gift"
      ]
    },
    {
      "invalidationKey": "character-creation.required-initial-gift-missing",
      "category": "required-selection-missing",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.required-initial-gift-missing",
      "trigger": "one of the Race, Auspice, or Tribe initial Gift slots is empty",
      "requiredResolutionType": "make-selection",
      "candidateResolutionOperationKeys": [
        "character-creation.select-initial-gift"
      ]
    },
    {
      "invalidationKey": "character-creation.metis-deformity-required",
      "category": "required-selection-missing",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.metis-deformity-required",
      "trigger": "Race is Metis and no valid deformity is selected",
      "requiredResolutionType": "make-selection",
      "candidateResolutionOperationKeys": [
        "character-creation.select-metis-deformity"
      ]
    },
    {
      "invalidationKey": "character-creation.metis-deformity-no-longer-applicable",
      "category": "classification-dependency",
      "defaultSeverity": "error",
      "messageKey": "character-creation.invalidation.metis-deformity-no-longer-applicable",
      "trigger": "Race changes from Metis while a deformity remains selected",
      "requiredResolutionType": "clear-dependent-selection",
      "candidateResolutionOperationKeys": [
        "character-creation.apply-classification-change",
        "character-creation.select-metis-deformity"
      ]
    },
    {
      "invalidationKey": "character-creation.attribute-allocation-invalid",
      "category": "allocation-overflow",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.attribute-allocation-invalid",
      "trigger": "Attribute priorities, ratings, or ledger entries no longer reconcile",
      "requiredResolutionType": "reallocate",
      "candidateResolutionOperationKeys": [
        "character-creation.set-attribute-priorities",
        "character-creation.set-attribute-rating"
      ]
    },
    {
      "invalidationKey": "character-creation.ability-allocation-invalid",
      "category": "allocation-overflow",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.ability-allocation-invalid",
      "trigger": "Ability priorities, ratings, restrictions, or ledger entries no longer reconcile",
      "requiredResolutionType": "reallocate",
      "candidateResolutionOperationKeys": [
        "character-creation.set-ability-priorities",
        "character-creation.set-ability-rating"
      ]
    },
    {
      "invalidationKey": "character-creation.background-allocation-invalid",
      "category": "allocation-overflow",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.background-allocation-invalid",
      "trigger": "Background ratings or ledger entries no longer reconcile",
      "requiredResolutionType": "reallocate",
      "candidateResolutionOperationKeys": [
        "character-creation.set-background-rating"
      ]
    },
    {
      "invalidationKey": "character-creation.specialization-no-longer-valid",
      "category": "specialization-validity",
      "defaultSeverity": "error",
      "messageKey": "character-creation.invalidation.specialization-no-longer-valid",
      "trigger": "the parent Attribute or Ability rating no longer qualifies for the specialization",
      "requiredResolutionType": "replace-or-clear-selection",
      "candidateResolutionOperationKeys": [
        "character-creation.set-specialization"
      ]
    },
    {
      "invalidationKey": "character-creation.resource-state-review-required",
      "category": "resource-reconciliation",
      "defaultSeverity": "blocking",
      "messageKey": "character-creation.invalidation.resource-state-review-required",
      "trigger": "classification-derived Rage, Gnosis, or Willpower changed or failed reconciliation",
      "requiredResolutionType": "recalculate-and-confirm",
      "candidateResolutionOperationKeys": [
        "character-creation.apply-classification-change",
        "character-creation.set-resource-rating"
      ]
    },
    {
      "invalidationKey": "character-creation.freebie-budget-overspent",
