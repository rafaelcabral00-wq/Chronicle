{
  "contractVersion": 1,
  "artifactKey": "character-creation.invalidations",
  "artifactVersion": "0.1.0-prototype",
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "character-creation.invalidations.display-name",
  "publicationStatus": "prototype-candidate",
  "scope": "CharacterCreation",
  "purpose": [
    "Represent creation-time state that became inconsistent after a valid upstream change.",
    "Prevent silent cascading edits when classifications, priorities, allocations, or selections change.",
    "Give the user an explicit list of items that must be reviewed or repaired before completion.",
    "Support deterministic validation, UI guidance, audit, and recovery."
  ],
  "authority": {
    "invalidationRuleAuthority": "RuleSet",
    "invalidationPersistenceAuthority": "Chronicle",
    "invalidationProposalAuthority": "RuleSet",
    "resolutionCommitAuthority": "Chronicle",
    "narratorMayCreate": false,
    "narratorMayResolve": false,
    "chronicleDirectorMayBypass": false
  },
  "collectionShape": {
    "characterId": "Reference",
    "draftVersion": "Integer",
    "items": "CharacterCreationInvalidationCollection",
    "openCount": "Integer",
    "blockingCount": "Integer",
    "contentFingerprint": "Text",
    "updatedAt": "Text"
  },
  "itemShape": {
    "invalidationId": "Reference",
    "invalidationKey": "Reference",
    "category": "Text",
