  "cyclePolicy": {
    "cyclesAllowed": false,
    "packageLoadFailsOnCycle": true,
    "diagnosticMustIncludeCyclePath": true,
    "runtimeCycleBreakingAllowed": false,
    "bidirectionalUserEditingIsNotGraphCycle": true,
    "reason": "The graph models causal recalculation and validation order, not all possible user navigation paths."
  },
  "affectedFieldResolutionPolicy": {
    "algorithm": "forward-transitive-closure",
    "includeStartingNodes": true,
    "includeConditionalEdgesOnlyWhenConditionMatches": true,
    "stopAtWorkflowBoundary": false,
    "return": [
      "directlyAffectedNodeKeys",
      "transitivelyAffectedNodeKeys",
      "recalculationActions",
      "preservationChecks",
      "createdInvalidationCandidates",
      "requiredOperationKeys",
      "validationRuleKeys"
    ]
  },
  "previewPolicy": {
    "requiredWhenAnyEdgeHasPreviewRequired": true,
    "previewMayNotMutateState": true,
    "previewMustUseCurrentDraftVersion": true,
    "previewFingerprintRequired": true,
    "applyOperationMustReferenceCompatiblePreviewWhenRequired": true,
    "stalePreviewRejected": true
  },
  "mutationPolicy": {
    "deterministicDerivedValuesMayBeRecalculated": true,
    "userSelectionsMayBeSilentlyReplaced": false,
    "userSelectionsMayBePreservedWhenStillValid": true,
    "nonApplicableConditionalSelectionsMayBeClearedOnlyByAuthorizedOperation": true,
    "ambiguousImpactCreatesInvalidation": true,
    "allMutationsAndInvalidationsPersistInSameTransaction": true
  },
