      "character-creation.initial-gift-no-longer-eligible": [
        "creation.initial-gifts",
        "creation.review-and-complete"
      ],
      "character-creation.required-initial-gift-missing": [
        "creation.initial-gifts",
        "creation.review-and-complete"
