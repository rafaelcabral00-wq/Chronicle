  "stageOperationPolicy": {
    "operationAvailabilityResolvedFromOperationIndex": true,
    "blockedOperationsRemainDiscoverable": true,
    "blockedOperationsExcludedFromAvailableOperationKeys": true,
    "unknownOperationKeyBehavior": "stage-computation-failure",
    "mutationWithoutOperationKeyAllowed": false
  },
  "dependencyProjection": {
    "sourceRef": "./dependency-graph.json",
    "nodeTypesIncluded": [
      "classification",
      "priority-assignment",
      "rating-collection",
      "selection",
      "derived-value",
      "resource",
      "specialization",
      "budget",
      "validation",
      "workflow"
    ],
    "edgeImpactModesRequiringReview": [
      "invalidate-for-review",
      "block-until-resolved"
    ],
    "edgeImpactModesAllowingSilentRecalc": [
      "deterministic-recalculate"
    ],
    "affectedStageStatusPolicy": {
      "deterministic-recalculate": "preserve-or-complete-when-valid",
      "invalidate-for-review": "review-required",
      "block-until-resolved": "blocked",
      "clear-if-not-applicable": "not-applicable-when-condition-false",
      "no-state-change-validation-only": "derive-from-validation-outcome"
    }
  },
  "invalidationMapping": {
    "sourceRef": "./invalidations.json",
