        "creation.review-and-complete"
      ],
      "character-creation.package-binding-incompatible": [
        "creation.review-and-complete"
      ],
      "character-creation.stage-review-required": [
        "creation.review-and-complete"
      ]
    }
  },
  "warningAcknowledgementProjection": {
    "sourceRef": "./warning-acknowledgements.json",
    "activeRequiredWarningBehavior": "does-not-change-stage-validity",
    "missingRequiredAcknowledgementBehavior": "review-and-complete-blocked",
    "warningCountIncludedPerStage": true
  },
  "giftBoundaryPolicy": {
    "initialGiftSlots": {
      "required": [
        "race",
        "auspice",
        "tribe"
      ],
      "minimumPerSlot": 1,
      "maximumPerSlot": 1,
      "distinctNormalizedGiftIdentityRequired": true,
      "stageKey": "creation.initial-gifts"
    },
    "additionalGiftPurchase": {
      "status": "blocked",
      "operationKeys": [
        "character-creation.purchase-additional-gift",
        "character-creation.remove-additional-gift"
      ],
      "reasonKey": "werewolf-prototype.capability.additional-gift-purchase.eligibility-unresolved",
      "stageKey": "creation.freebie-points",
      "testsMustAssertUnavailable": true,
      "runtimeExecutionEnabled": false
    },
    "runtimeGiftEffects": {
      "enabled": false,
      "status": "excluded",
      "reasonKey": "werewolf-prototype.capability.gift-runtime.outside-current-slice"
    }
  },
  "computationPolicy": {
    "deterministic": true,
    "recomputeAfterEveryCommittedCreationOperation": true,
    "recomputeOnValidation": true,
    "recomputeOnExplicitReviewRequest": true,
    "inputRequirements": [
      "character-draft",
      "operation-index",
      "dependency-graph",
      "invalidations",
      "warning-acknowledgements",
      "latest-validation-summary"
    ],
    "stageOrdering": "stage-definition-order",
    "currentStageSelectionPolicy": {
      "preferFirstRequiredStageNotInCompletionEligibleStatus": true,
      "fallbackToReviewAndCompleteWhenAllRequiredEligible": true,
      "conditionalStagesIgnoredWhenNotApplicable": true
    },
    "reviewRequiredComputation": {
      "triggeredBy": [
        "open-warning-or-invalidation-with-review-required-impact",
        "dependency-edge-impact-mode-invalidate-for-review"
      ],
      "cannotAutoResolve": true
    }
  },
  "stageStatusRules": [
    {
      "ruleKey": "stage-state.required-stage-must-be-complete-or-not-applicable",
      "severity": "blocking",
      "requirement": "every required applicable stage is complete before review-and-complete can become complete"
    },
    {
      "ruleKey": "stage-state.blocking-invalidation-blocks-stage",
      "severity": "blocking",
      "requirement": "stage with open blocking or error invalidation mapped to it cannot be complete"
    },
    {
      "ruleKey": "stage-state.review-required-distinct-from-blocked",
      "severity": "blocking",
      "requirement": "review-required means explicit user review is needed, not hard operation unavailability"
    },
    {
      "ruleKey": "stage-state.blocked-operations-excluded-from-available",
      "severity": "blocking",
      "requirement": "operation keys with blocked readiness must not be returned in availableOperationKeys"
    },
    {
      "ruleKey": "stage-state.metis-stage-conditional-applicability",
      "severity": "blocking",
      "requirement": "metis-deformity stage is not-applicable unless race is character.race.metis"
    },
    {
      "ruleKey": "stage-state.fingerprint-recomputes",
      "severity": "blocking",
      "requirement": "stage and collection fingerprints recompute from canonical serialization"
    }
  ],
  "projectionForConsumers": {
    "reviewSummary": {
      "sourceRef": "./review-summary.json",
      "requiredFields": [
        "stageKey",
        "status",
        "availability",
        "isRequired",
        "isMechanicallyValid",
        "isReviewRequired",
        "blockingIssueCount",
        "errorCount",
        "warningCount",
        "remainingBudgets",
        "availableOperationKeys",
        "blockedOperationKeys"
      ]
    },
    "characterSheet": {
      "sourceRef": "../../character-sheet/character-sheet-index.json",
      "renderingMode": "creation-preview",
      "blockedOperationsMustShowReason": true,
      "reviewRequiredStagesMustBeVisible": true
    },
    "validationIndex": {
      "sourceRef": "../validation/validation-index.json",
      "supportsCurrentStageMode": true
    }
  },
  "securityPolicy": {
    "encryptedAtRest": true,
    "networkAccessRequired": false,
    "providerCallAllowed": false,
    "secretAccessAllowed": false,
    "ordinaryLogsMayContain": [
      "characterId",
      "draftVersion",
      "stage-status-counts",
      "blocking-summary",
      "contentFingerprint"
    ],
    "ordinaryLogsMustExclude": [
      "raw-narrative-text",
      "sourcebook-text",
      "provider-secrets"
    ]
  },
  "serializationPolicy": {
    "canonicalFormat": "JSON",
    "canonicalPropertyOrderingRequiredForFingerprint": true,
    "unicodeNormalization": "NFC",
    "timestampFormat": "RFC3339-UTC",
    "nullFieldsIncludedInFingerprint": false
  },
  "fingerprintPolicy": {
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "unicodeNormalization": "NFC",
    "fingerprintCovers": [
      "characterId",
      "draftVersion",
      "currentStageKey",
      "stages",
      "requiredStageSummary",
      "blockingSummary"
    ]
  },
  "recoveryPolicy": {
    "projectionRebuildAllowed": true,
    "authoritativeStateMutationAllowed": false,
    "rebuildSources": [
      "character-draft",
      "operation-index",
      "dependency-graph",
      "invalidations",
      "warning-acknowledgements",
      "validation-results"
    ],
    "rebuildMismatchBehavior": "replace-stage-projection-and-record-diagnostic",
    "corruptSourceBehavior": "mark-recovery-required-and-block-completion"
  },
  "source": {
    "sourceDocumentId": "source.werewolf3e.cleaned-ptbr",
    "sourceDocumentVersion": 1,
    "sourceFingerprint": "a4302e2938a137fb42d154c45decd43e02a19a2ba0eb3030b6eb1de942dab64a"
  },
  "review": {
    "sourceRuleDependency": "indirect-through-profile-dependency-and-validation-artifacts",
    "architectureConfidence": "high",
    "semanticReviewStatus": "pending",
    "implementationReviewStatus": "pending",
    "securityReviewStatus": "pending",
    "contractConsistencyReviewStatus": "pending"
  },
  "prototypeNotes": [
    "Stage state is a deterministic projection and does not authorize completion by itself.",
    "The complete-character operation must rerun fresh validation inside its own authoritative transaction.",
    "Review-required state preserves user-owned selections that became invalid instead of silently replacing them.",
    "Initial gifts are constrained to one race, one auspice, and one tribe selection in this slice.",
    "Additional gift purchase and removal remain blocked until eligibility scope is source-reviewed and promoted.",
    "Gift runtime execution is excluded from the current slice and cannot appear as available here.",
    "Chronicle owns persistence, encryption, fingerprints, and transactional boundaries.",
    "The Rule Set owns stage definitions, dependency semantics, status mapping, and boundary semantics."
  ]
}