      ],
      "character-creation.ability-allocation-invalid": [
        "creation.abilities",
        "creation.freebie-points",
        "creation.review-and-complete"
      ],
      "character-creation.background-allocation-invalid": [
        "creation.backgrounds",
        "creation.freebie-points",
        "creation.review-and-complete"
      ],
      "character-creation.specialization-no-longer-valid": [
        "creation.specializations",
        "creation.review-and-complete"
      ],
      "character-creation.resource-state-review-required": [
        "creation.resources-renown-rank",
        "creation.review-and-complete"
