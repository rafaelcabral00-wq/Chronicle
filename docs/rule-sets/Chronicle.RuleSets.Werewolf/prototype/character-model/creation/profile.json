    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.freebie-unspent",
      "severity": "medium",
      "status": "semantic-review-required",
      "question": "May a Character complete creation with unspent freebie points?",
      "prototypeDecision": "Allow unspent points but never allow overspending."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.freebie-limits",
      "severity": "high",
      "status": "semantic-review-required",
      "question": "What per-category maxima and eligibility constraints apply during freebie spending?",
      "prototypeDecision": "Use known field maxima and explicit restrictions only; do not infer additional limits."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.freebie-gift-source",
      "severity": "high",
      "status": "source-search-required",
      "question": "Which Gift lists may supply an additional Level One Gift purchased with freebies?",
      "prototypeDecision": "Keep purchase support candidate and require Rule Set validation before exposure."
    },
    {
      "ambiguityKey": "ambiguity.werewolf3e.creation.resource-current-values",
      "severity": "high",
      "status": "semantic-review-required",
      "question": "Do current resources begin equal to permanent ratings?",
      "prototypeDecision": "Yes for the prototype, with explicit reversibility."
    },
