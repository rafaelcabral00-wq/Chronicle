  "dependencyRecalculation": {
    "mode": "preview-and-confirm",
    "previewOperationKey": "character-creation.preview-dependency-recalculation",
    "applyOperationKey": "character-creation.apply-dependency-recalculation",
    "previewIncludes": [
      "preserved-values",
      "reinitialized-values",
      "invalidated-selections",
      "removed-selections",
      "refunded-costs",
      "newly-required-selections",
      "new-validation-errors"
    ],
    "userConfirmationRequired": true,
    "auditRequired": true
  },
  "completionPolicy": {
    "operationKey": "character-creation.complete-character",
    "allowCompletionWithWarnings": true,
    "allowCompletionWithErrors": false,
    "allowCompletionWithBlockedRequiredCapability": false,
    "freezeCreationLedger": true,
    "persistRuleSetBinding": true,
    "persistPackageVersion": true,
    "persistContractVersions": true,
    "emitDomainEvent": "CharacterCreationCompleted"
  },
  "creationLedger": {
    "enabled": true,
    "recordBaseAllocations": true,
    "recordFreebiePurchases": true,
    "recordClassificationInitializations": true,
    "recordRefunds": true,
    "recordPrototypeDecisionsApplied": true,
    "immutableAfterCompletion": true
  },
