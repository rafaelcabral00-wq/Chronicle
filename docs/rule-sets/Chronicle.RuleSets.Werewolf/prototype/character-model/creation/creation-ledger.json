  "budgetDefinitions": [
    {
      "budgetKey": "character-creation.attribute-points",
      "budgetKind": "priority-derived-category-allocation",
      "initialAmount": {
        "physical": "derived-from-priority-assignment",
        "social": "derived-from-priority-assignment",
        "mental": "derived-from-priority-assignment"
      },
      "priorityAmounts": [
        7,
        5,
        3
      ],
      "baseRatingExcludedFromBudget": true,
      "overspendAllowed": false,
      "underspendAtCompletionAllowed": false
    },
    {
      "budgetKey": "character-creation.ability-points",
      "budgetKind": "priority-derived-category-allocation",
      "initialAmount": {
        "talents": "derived-from-priority-assignment",
        "skills": "derived-from-priority-assignment",
        "knowledges": "derived-from-priority-assignment"
      },
      "priorityAmounts": [
        13,
        9,
        5
      ],
      "overspendAllowed": false,
      "underspendAtCompletionAllowed": false
    },
    {
      "budgetKey": "character-creation.background-points",
      "budgetKind": "fixed-pool",
      "initialAmount": 5,
      "overspendAllowed": false,
      "underspendAtCompletionAllowed": false
    },
    {
      "budgetKey": "character-creation.freebie-points",
      "budgetKind": "fixed-pool",
      "initialAmount": 15,
      "overspendAllowed": false,
      "underspendAtCompletionAllowed": true,
      "costTable": {
        "attribute-per-dot": 5,
        "ability-per-dot": 2,
        "background-per-dot": 1,
        "level-one-gift": 7,
        "rage-per-dot": 1,
        "gnosis-per-dot": 2,
        "willpower-per-dot": 1
      }
    }
  ],
  "budgetEffectShape": {
    "budgetKey": "Reference",
    "dimensionKey": "Reference",
    "effectType": "Text",
    "amount": "Integer",
    "unit": "Text",
    "costPerUnit": "Integer",
    "totalCost": "Integer"
  },
  "budgetEffectPolicy": {
    "allowedEffectTypes": [
      "allocate",
      "spend",
      "refund",
      "initialize",
      "rebase"
    ],
    "positiveAmountRequired": true,
    "refundMustReferenceOriginalEntry": true,
    "refundCannotExceedUnrefundedOriginalCost": true,
    "mutableRunningTotalIsNonAuthoritative": true,
    "authoritativeBalanceDerivedFromEntries": true,
    "summaryMustMatchRecalculation": true
  },
  "sourceSeparationPolicy": {
    "classificationDerivedAndPurchasedValuesMustRemainDistinct": true,
    "baseAllocationAndFreebiePurchaseMustRemainDistinct": true,
    "refundMustReverseSpecificPurchaseSource": true,
    "silentReclassificationOfEntrySourceAllowed": false,
    "historicalEntriesMayBeSupersededButNeverDeleted": true
  },
  "integrityRules": [
    {
      "ruleKey": "creation-ledger.sequence-contiguous",
      "severity": "blocking",
      "requirement": "entry sequences begin at one and increase by one"
    },
    {
      "ruleKey": "creation-ledger.entry-id-unique",
      "severity": "blocking",
      "requirement": "entryId is unique within the ledger"
    },
    {
      "ruleKey": "creation-ledger.operation-id-present",
      "severity": "blocking",
      "requirement": "every entry references the operation that created it"
    },
    {
      "ruleKey": "creation-ledger.fingerprint-valid",
      "severity": "blocking",
      "requirement": "each entry fingerprint and the ledger content fingerprint recompute successfully"
    },
    {
      "ruleKey": "creation-ledger.budget-summary-reconciles",
      "severity": "blocking",
      "requirement": "stored summaries equal deterministic reconstruction from entries"
    },
    {
      "ruleKey": "creation-ledger.no-overspend",
      "severity": "blocking",
      "requirement": "no budget balance is negative after any committed sequence"
    },
    {
      "ruleKey": "creation-ledger.refund-source-valid",
      "severity": "blocking",
      "requirement": "every refund references an existing unrefunded purchase entry"
    },
    {
      "ruleKey": "creation-ledger.frozen-is-immutable",
      "severity": "blocking",
      "requirement": "no normal operation appends entries after ledger freeze"
    },
    {
      "ruleKey": "creation-ledger.character-binding-valid",
      "severity": "blocking",
      "requirement": "ledger characterId, campaignId, and package binding match the Character"
    }
  ],
  "appendPolicy": {
    "appendOnly": true,
    "hardDeleteAllowed": false,
    "inPlaceEntryUpdateAllowed": false,
    "correctionMethod": "append-compensating-or-recovery-entry",
    "expectedCharacterVersionRequired": true,
    "idempotencyRequired": true,
    "singleTransactionWithCharacterMutationRequired": true,
    "entryFingerprintRequired": true,
    "ledgerFingerprintRecalculationRequired": true
  },
  "summaryProjection": {
    "authoritative": false,
    "rebuildable": true,
    "fields": {
      "attributePointsRemaining": "StructuredObject",
      "abilityPointsRemaining": "StructuredObject",
      "backgroundPointsRemaining": "Integer",
      "freebiePointsRemaining": "Integer",
      "spentByEntryType": "StructuredObject",
      "refundedByEntryType": "StructuredObject",
      "lastSequence": "Integer",
      "lastUpdatedAt": "Text"
    }
  },
  "freezePolicy": {
    "triggerOperation": "character-creation.complete-character",
    "freshValidationRequired": true,
    "openInvalidationsAllowed": false,
    "invalidIntegrityAllowed": false,
    "appendFreezeEntry": true,
    "freezeAndActivateCharacterInSameTransaction": true,
    "snapshotLedgerInsideCompletionSnapshot": true
  },
  "recoveryPolicy": {
    "automaticRepairAllowed": false,
    "detectionCases": [
      "budget-summary-mismatch",
      "fingerprint-mismatch",
      "sequence-gap",
      "invalid-refund-reference",
      "frozen-ledger-with-draft-character",
      "active-character-with-open-ledger"
    ],
    "onDetection": {
      "setIntegrityStatus": "invalid",
      "setStatus": "recovery-required",
      "blockNormalMutation": true
    },
    "repairRequires": [
      "explicit-recovery-operation",
      "audited-reason",
      "before-and-after-fingerprints",
      "compensating-entry-when-data-change-is-required"
    ]
  },
  "securityPolicy": {
    "encryptedAtRest": true,
    "containsNarrativePayloadByDefault": false,
    "narrativeEntriesStore": "references-fingerprints-and-lengths-only",
    "ordinaryLogsMayContain": [
      "ledgerId",
      "characterId",
      "entryType",
      "sequence",
      "budget-deltas",
      "fingerprints"
    ],
    "ordinaryLogsMustExclude": [
      "raw-narrative-text",
      "provider-secrets",
      "sourcebook-text"
    ],
    "networkAccessRequired": false
  },
  "serializationPolicy": {
    "canonicalFormat": "JSON",
    "canonicalPropertyOrderingRequiredForFingerprint": true,
    "unicodeNormalization": "NFC",
    "timestampFormat": "RFC3339-UTC",
    "numericRepresentation": "base-10-integer",
    "nullFieldsIncludedInFingerprint": false
  },
