  "displayNameResourceKey": "character-creation.creation-ledger.display-name",
  "publicationStatus": "prototype-candidate",
  "scope": "CharacterCreation",
  "purpose": [
    "Record every creation-time mechanical allocation and refund as an immutable entry.",
    "Separate classification-derived values from purchased values.",
    "Provide deterministic budget reconstruction without trusting mutable totals.",
    "Support validation, completion snapshots, recovery, audit, and diagnostics."
  ],
