      "post-creation-character-operations",
      "runtime-gift-execution",
      "additional-rule-set-mechanics",
      "print-character-sheet"
    ]
  },
  "boundaryPolicy": {
    "prototypeArtifactsMayRunInProduction": false,
    "prototypeArtifactsMayBeLoadedByDeveloperTools": true,
    "prototypeArtifactsMayBeLoadedByTestInfrastructure": true,
    "prototypeArtifactsMayBeUsedAsPromotionInputs": true,
    "prototypeArtifactsMayBeCopiedDirectlyToPublishedPackage": false,
    "promotionMustCreateNewVersionedArtifacts": true,
    "rawSourceDocumentsMayEnterRuntimePackage": false,
    "prototypeFixturesMayEnterRuntimePackage": false,
    "prototypeTestsMayEnterRuntimePackage": false
  },
  "directoryContract": {
    "prototypeRoot": "./",
    "requiredDirectories": [
      "./character-model",
      "./operations",
      "./character-sheet",
      "./fixtures",
      "./tests"
    ],
    "allowedTopLevelFiles": [
      "./manifest.json",
      "./prototype-index.json",
      "./prototype-package-index.json"
    ],
    "unknownTopLevelEntryBehavior": "diagnostic-and-promotion-block",
    "artifactEscapeAllowed": false
  },
  "loadPolicy": {
    "loadMode": "top-level-index-driven",
    "sortBy": "loadOrder",
    "duplicateArtifactKeyBehavior": "prototype-package-load-failure",
    "missingRequiredArtifactBehavior": "prototype-package-load-failure",
    "unsupportedContractVersionBehavior": "prototype-package-load-failure",
    "artifactOutsidePrototypeRootAllowed": false,
    "networkResolutionAllowed": false,
    "hardcodedFallbackAllowed": false,
    "nestedIndexesValidatedRecursively": true
  },
  "dependencyPolicy": {
    "allDeclaredDependenciesMustResolve": true,
    "cyclesAllowed": false,
    "cycleBehavior": "prototype-package-load-failure-with-cycle-path",
    "loadOrderMustRespectDependencies": true,
    "runtimeModelValidatedBeforeFixtures": true,
    "fixturesValidatedBeforeTests": true,
    "testsValidatedBeforePromotionEvaluation": true
  },
  "readinessPolicy": {
    "allowedValues": [
      "prototype-candidate",
      "candidate-partial",
      "blocked",
      "future"
    ],
    "requiredBlockedRootArtifactBehavior": "prototype-package-unavailable",
    "partialRuntimeArtifactBehavior": "dependent-capability-disabled",
    "blockedOptionalCapabilityBehavior": "remain-visible-but-unavailable",
    "futureCapabilitiesDoNotBlockCurrentSlice": true,
    "promotionRequiresAllCurrentRequiredArtifactsReady": true
  },
  "validationPolicy": {
    "validateOnLoad": true,
    "validatePackageIdentity": true,
    "validateManifestBinding": true,
    "validateRootArtifactKeys": true,
    "validateArtifactReferences": true,
    "validateContractVersions": true,
    "validateDependencyGraphAcyclic": true,
    "validateNestedIndexes": true,
    "validateRuntimeModelBindings": true,
    "validateFixtureBindings": true,
    "validateTestBindings": true,
    "validatePromotionBindings": true,
    "validateDirectoryContract": true,
    "validateSecurityDeclarations": true,
    "validateFingerprints": true
  },
  "promotionIntegration": {
    "promotionGateArtifactKey": "werewolf-prototype.promotion-gate",
    "testModelArtifactKey": "werewolf-prototype.test-model-index",
    "promotionTargetRoot": "../package",
    "promotionAllowedOnlyWhenGatePassed": true,
    "promotionRequiresCleanWorkingTree": true,
    "promotionRequiresReproducibleBuild": true,
    "promotionRequiresCanonicalTestReport": true,
    "promotionRecordsPrototypePackageIndexFingerprint": true,
    "promotionPreservesPrototypeHistory": true
  },
  "consistencyRules": [
    {
      "ruleKey": "prototype-package-index.package-identity-consistent",
      "severity": "blocking",
      "requirement": "packageId and prototypeVersion reconcile across all root artifacts"
    },
    {
      "ruleKey": "prototype-package-index.root-artifact-keys-unique",
      "severity": "blocking",
      "requirement": "every root artifact key is unique"
    },
    {
      "ruleKey": "prototype-package-index.refs-resolve",
      "severity": "blocking",
      "requirement": "all required root, runtime, fixture, test, and promotion references resolve"
    },
    {
      "ruleKey": "prototype-package-index.dependencies-acyclic",
      "severity": "blocking",
      "requirement": "all top-level and nested artifact dependencies are acyclic"
    },
    {
      "ruleKey": "prototype-package-index.directory-contract-valid",
      "severity": "blocking",
      "requirement": "the prototype directory contains only allowed roots and declared artifacts"
    },
    {
      "ruleKey": "prototype-package-index.runtime-boundaries-valid",
      "severity": "blocking",
      "requirement": "prototype-only fixtures, tests, reviews, and source documents are excluded from runtime publication"
    },
    {
      "ruleKey": "prototype-package-index.capability-readiness-explicit",
      "severity": "blocking",
      "requirement": "supported, blocked, and future capabilities are explicitly declared"
    },
    {
      "ruleKey": "prototype-package-index.promotion-bindings-valid",
      "severity": "blocking",
      "requirement": "test model, report schema, promotion gate, and target package bindings reconcile"
    }
  ],
  "fingerprintPolicy": {
    "indexFingerprintRequired": true,
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "includeRootArtifactFingerprints": true,
    "includeRuntimeModelFingerprints": true,
    "includeFixtureIndexFingerprint": true,
    "includeTestModelFingerprint": true,
    "includeCapabilitySummary": true,
    "includeBoundaryPolicy": true,
    "includeDirectoryContract": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncluded": false
  },
  "diagnosticProjection": {
