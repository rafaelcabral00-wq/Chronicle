{
  "contractVersion": 1,
  "artifactKey": "werewolf-prototype.prototype-package-index",
  "artifactVersion": "0.1.0-prototype",
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "werewolf-prototype.package-index.display-name",
  "publicationStatus": "prototype-candidate",
  "scope": "PrototypePackage",
  "purpose": [
    "Provide the canonical top-level discovery surface for the complete Werewolf prototype package.",
    "Bind the prototype manifest, runtime model indexes, fixture model, test model, package boundaries, readiness, and promotion metadata.",
    "Allow Chronicle tooling to load, validate, test, diagnose, and promote the prototype without Werewolf-specific registration.",
    "Define the exact boundary between prototype-only artifacts and future published package artifacts."
  ],
  "authority": {
    "indexDefinitionAuthority": "RuleSetPackage",
    "packageDiscoveryAuthority": "Chronicle",
    "packageContractValidationAuthority": "Chronicle",
    "testModelAuthority": "ChronicleTestInfrastructure",
    "promotionAuthority": "ChronicleBuildAndReleaseInfrastructure",
    "mechanicalSemanticsAuthority": "RuleSet",
    "hardcodedWerewolfRegistrationAllowed": false
  },
  "packageIdentity": {
    "packageId": "chronicle.rulesets.werewolf",
    "prototypeVersion": "0.1.0-prototype",
    "packageKind": "rule-set-prototype",
    "canonicalTechnicalLanguage": "en",
    "runtimePublicationStatus": "not-published",
    "sourceType": "reviewed-extraction-candidate",
    "localFirst": true,
    "networkRequired": false
  },
  "rootArtifacts": [
