  "decisionDependencyPolicy": {
    "dependenciesMustResolve": true,
    "cyclesAllowed": false,
    "loadOrderMustRespectDependencies": true,
    "dependentDecisionSetMayBeDraftedBeforeDependencyFinalizes": true,
    "dependentDecisionSetMayFinalizeBeforeDependencyFinalizes": false,
    "staleDependencyFingerprintReopensDependentDecisionSet": true,
    "candidateTemplatesMayReferencePendingDependencies": true,
    "candidateTemplatesAreNeverAuthority": true
