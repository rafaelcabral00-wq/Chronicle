    "reviewNarrativeIsNotDecisionAuthority": true,
    "candidateTemplateIsNotDecisionAuthority": true,
    "onlyActiveFinalDecisionEntriesAreAuthority": true,
    "missingDecisionRemainsUnresolved": true,
