  "consistencyRules": [
    {
      "ruleKey": "review-decision-index.decision-set-keys-unique",
      "severity": "blocking",
      "requirement": "every decisionSetKey is unique"
    },
    {
      "ruleKey": "review-decision-index.artifact-refs-resolve",
      "severity": "blocking",
      "requirement": "every required decision set and review artifact reference resolves"
    },
    {
      "ruleKey": "review-decision-index.dependencies-resolve",
      "severity": "blocking",
      "requirement": "every declared decision set dependency resolves"
    },
    {
      "ruleKey": "review-decision-index.dependencies-acyclic",
      "severity": "blocking",
      "requirement": "decision set dependencies are acyclic"
    },
    {
      "ruleKey": "review-decision-index.finalized-evidence-current",
      "severity": "blocking",
      "requirement": "every finalized decision set has current evidence and reconciled dependent artifacts"
    },
    {
      "ruleKey": "review-decision-index.summary-reconciles",
      "severity": "blocking",
      "requirement": "decision summary counts reconcile with indexed decision set statuses"
    },
    {
      "ruleKey": "review-decision-index.current-slice-requirements-complete",
      "severity": "blocking",
      "requirement": "all current-slice decision categories are declared"
    },
    {
      "ruleKey": "review-decision-index.no-candidate-authority",
      "severity": "blocking",
      "requirement": "candidate templates never count as active final decisions"
    }
