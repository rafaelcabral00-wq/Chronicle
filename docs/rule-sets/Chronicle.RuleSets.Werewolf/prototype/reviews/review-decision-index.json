    "duplicateArtifactKeyBehavior": "decision-model-load-failure",
    "missingRequiredDecisionSetBehavior": "decision-model-incomplete",
    "unsupportedContractVersionBehavior": "decision-model-load-failure",
    "artifactOutsideReviewRootAllowed": false,
    "networkResolutionAllowed": false,
    "hardcodedFallbackAllowed": false
