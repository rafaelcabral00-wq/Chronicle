  "finalizationPolicy": {
    "allowedStatuses": [
      "draft",
      "in-progress",
      "blocked",
      "finalized",
      "superseded"
    ],
    "finalizedRequiresAllRequiredTargetsResolved": true,
    "finalizedRequiresEvidenceFingerprint": true,
    "finalizedRequiresReviewerIdentity": true,
    "finalizedRequiresCompletionTimestamp": true,
    "finalizedRequiresReconciliationComplete": true,
    "finalizedRequiresAffectedTestsPassed": true,
    "supersededRequiresReplacementDecisionSetRef": true,
    "manualStatusOverrideAllowed": false
