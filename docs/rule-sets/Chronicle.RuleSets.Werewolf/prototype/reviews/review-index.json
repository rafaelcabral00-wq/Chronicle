  "statusCalculation": {
    "currentSliceReviewsApprovedWhen": "all-current-slice-approval-requirements-have-approved-or-approved-with-exclusions-decisions",
    "promotionReviewsApprovedWhen": "all-promotion-approval-requirements-have-current-final-evidence",
    "reviewModelStatus": "in-progress",
    "promotionReviewStatus": "blocked",
    "automaticApprovalAllowed": false
  },
  "loadPolicy": {
    "loadMode": "index-driven",
    "sortBy": "loadOrder",
    "duplicateReviewKeyBehavior": "review-model-load-failure",
    "duplicateArtifactKeyBehavior": "review-model-load-failure",
    "missingRequiredReviewBehavior": "review-model-incomplete",
    "unsupportedContractVersionBehavior": "review-model-load-failure",
    "artifactOutsideReviewRootAllowed": false,
    "networkResolutionAllowed": false,
    "hardcodedFallbackAllowed": false
  },
  "consistencyRules": [
    {
      "ruleKey": "review-index.review-keys-unique",
      "severity": "blocking",
      "requirement": "every reviewKey is unique across materialized and planned reviews"
    },
    {
      "ruleKey": "review-index.materialized-artifact-refs-resolve",
      "severity": "blocking",
      "requirement": "every materialized review artifact reference resolves"
    },
    {
      "ruleKey": "review-index.dependencies-resolve",
      "severity": "blocking",
      "requirement": "every declared review dependency resolves"
    },
    {
      "ruleKey": "review-index.dependencies-acyclic",
      "severity": "blocking",
      "requirement": "review dependencies are acyclic"
    },
    {
      "ruleKey": "review-index.status-summary-reconciles",
      "severity": "blocking",
      "requirement": "summary counts reconcile with materialized and planned review statuses"
    },
    {
      "ruleKey": "review-index.current-slice-requirements-complete",
      "severity": "blocking",
      "requirement": "all required current-slice reviews are declared and materialized"
    },
    {
      "ruleKey": "review-index.promotion-requirements-complete",
      "severity": "blocking",
      "requirement": "all promotion review categories are declared"
    },
    {
      "ruleKey": "review-index.no-approval-with-stale-evidence",
      "severity": "blocking",
      "requirement": "no approved review relies on stale or missing evidence"
    }
  ],
  "fingerprintPolicy": {
    "indexFingerprintRequired": true,
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "includeMaterializedReviewFingerprints": true,
    "includePlannedReviews": true,
    "includeDependencyMetadata": true,
    "includeApprovalRequirements": true,
    "includeCurrentReviewSummary": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncluded": false
  },
  "diagnosticProjection": {
    "include": [
      "reviewKey",
      "reviewRole",
      "ownerType",
      "status",
      "overallDecision",
      "dependencyStatus",
      "evidenceStatus",
      "promotionImpact",
      "staleEvidenceRefs",
      "nextExecutableReviewKey"
    ],
    "developerDetailsOnlyInDeveloperMode": true,
    "rawSourceTextIncluded": false,
    "sourcebookTextIncluded": false,
    "secretsIncluded": false
  },
  "securityPolicy": {
    "networkAccessRequired": false,
    "providerAccessRequired": false,
    "containsProductionUserData": false,
    "containsProviderSecrets": false,
    "ordinaryLogsMayContain": [
