  "reviewDependencyPolicy": {
    "dependenciesMustResolve": true,
    "cyclesAllowed": false,
    "loadOrderMustRespectDependencies": true,
    "dependentReviewMayStartBeforeDependencyComplete": false,
    "dependentReviewMayBeDraftedBeforeDependencyComplete": true,
    "dependentReviewMayBeApprovedBeforeDependencyComplete": false,
    "staleDependencyEvidenceReopensDependentReview": true
  },
  "approvalPolicy": {
    "allowedOverallDecisions": [
      "not-approved",
      "approved",
      "approved-with-exclusions",
      "rejected",
      "superseded"
    ],
    "approvedRequiresFinalEvidence": true,
    "approvedWithExclusionsRequiresExplicitExclusionRecord": true,
    "rejectedRequiresRationaleAndImpact": true,
    "supersededRequiresReplacementReviewRef": true,
    "manualDecisionWithoutVersionedEvidenceAllowed": false
  },
  "evidencePolicy": {
    "allFinalReviewsRequireEvidenceFingerprint": true,
    "allEvidenceMustReferenceReviewedArtifactFingerprints": true,
    "staleEvidenceInvalidatesApproval": true,
    "reviewerIdentityRequiredForFinalization": true,
    "completionTimestampRequiredForFinalization": true,
    "rawSourcebookTextMayNotBeEmbedded": true,
    "evidenceMayReferenceExternalReviewDocuments": true
  },
  "currentReviewSummary": {
    "materializedReviewCount": 3,
    "plannedReviewCount": 6,
    "approvedReviewCount": 0,
    "inProgressReviewCount": 3,
    "notStartedReviewCount": 6,
