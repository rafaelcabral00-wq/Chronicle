  "productionPolicy": {
    "evidenceProducedOnlyAfterWorkExecution": true,
    "artifactPresenceDoesNotCountAsEvidence": true,
    "candidateTemplateDoesNotCountAsEvidence": true,
    "producerMustBeAssigned": true,
    "producerAndValidatorMustBeDistinctWhenRequired": true,
    "sourceEvidenceMustReferenceReviewedExtraction": true,
    "allEvidenceRequiresArtifactFingerprints": true,
    "timestampsUseUtc": true
  },
  "validationPolicy": {
    "evidenceSchemaMustValidate": true,
    "allReferencedArtifactsMustResolve": true,
    "allReferencedFingerprintsMustBeCurrent": true,
    "allReferencedTasksActionsChecksIssuesAndBlockersMustResolve": true,
    "substantiveSourceClaimsRequireRuleSetReviewValidation": true,
    "testEvidenceRequiresCanonicalTestRunReport": true,
    "promotionEvidenceRequiresBuildAndReleaseValidation": true,
    "manualValidationOverrideAllowed": false
  },
  "acceptancePolicy": {
    "acceptedEvidenceStatuses": [
      "validated",
      "validated-with-warnings"
    ],
    "rejectedEvidenceCannotSatisfyCheck": true,
    "submittedEvidenceCannotSatisfyCompletion": true,
    "staleEvidenceCannotSatisfyCompletion": true,
    "validatedWithWarningsMaySatisfyNonblockingCheck": true,
    "validatedWithWarningsMayNotSatisfyCriticalSourceIdentityDecision": true
  },
  "stalenessPolicy": {
    "sourceFingerprintChangeStalesSourceEvidence": true,
    "catalogFingerprintChangeStalesCatalogEvidence": true,
    "decisionFingerprintChangeStalesReconciliationEvidence": true,
    "fixtureFingerprintChangeStalesFixtureEvidence": true,
    "testSuiteOrReportFingerprintChangeStalesTestEvidence": true,
    "reviewRecordFingerprintChangeStalesDependentEvidence": true,
    "issueOrBlockerStateChangeRecalculatesEvidenceEligibility": true,
    "automaticStaleTransitionAllowed": true,
    "silentEvidenceReuseAllowed": false
  },
  "issueAndBlockerIntegration": {
    "missingRequiredEvidenceMayOpenIssue": true,
    "rejectedCriticalEvidenceOpensOrUpdatesIssue": true,
    "staleRequiredEvidenceMayReopenIssueOrBlocker": true,
    "resolvedIssueRequiresCurrentResolutionEvidence": true,
    "verifiedBlockerRequiresIndependentEvidenceValidation": true,
    "unrelatedIssueMayNotInvalidateEvidenceOutsideItsScope": true
  },
  "taskAndActionIntegration": {
    "taskCompletionRequiresAllDeclaredEvidence": true,
    "actionCompletionRequiresAllDeclaredOutputEvidence": true,
    "evidenceValidationRecalculatesTaskAndActionReadiness": true,
    "staleEvidenceReopensDependentTaskOrAction": true,
    "evidenceWorkItemOrderMustRespectExecutionPlan": true
  },
  "promotionIntegration": {
    "sourceReviewApprovalRequiresAllSourceReviewEvidence": true,
    "semanticApprovalRequiresAllCatalogReviewAndDecisionEvidence": true,
    "fixtureApprovalRequiresCurrentFixtureValidationEvidence": true,
    "testApprovalRequiresCanonicalPassingTestEvidence": true,
    "securityApprovalRequiresCurrentSecurityReviewEvidence": true,
    "promotionReportMustListMissingRejectedAndStaleEvidence": true
  },
