  "specificCheckDefinitions": [
    {
      "checkKey": "catalog-review.races.gnosis-values-resolve",
      "required": true,
      "description": "Homid, Metis, and Lupus identities bind to reviewed initial Gnosis values."
    },
    {
      "checkKey": "catalog-review.races.gift-eligibility-resolves",
      "required": true,
      "description": "Race identities bind only to reviewed initial Gift eligibility."
    },
    {
      "checkKey": "catalog-review.races.metis-deformity-applicability-resolves",
      "required": true,
      "description": "Metis identity activates the deformity requirement and other races do not."
    },
    {
      "checkKey": "catalog-review.auspices.rage-values-resolve",
      "required": true,
      "description": "Auspice identities bind to reviewed initial Rage values."
    },
    {
      "checkKey": "catalog-review.auspices.initial-renown-resolves",
      "required": true,
      "description": "Auspice identities bind to reviewed initial Renown rules."
    },
    {
      "checkKey": "catalog-review.auspices.gift-eligibility-resolves",
      "required": true,
      "description": "Auspice identities bind only to reviewed initial Gift eligibility."
    },
    {
      "checkKey": "catalog-review.tribes.willpower-values-resolve",
      "required": true,
      "description": "Tribe identities bind to reviewed initial Willpower values."
    },
    {
      "checkKey": "catalog-review.tribes.gift-eligibility-resolves",
      "required": true,
      "description": "Tribe identities bind only to reviewed initial Gift eligibility."
    },
    {
      "checkKey": "catalog-review.tribes.background-restrictions-resolve",
      "required": true,
      "description": "Any Tribe-specific Background restrictions reference valid reviewed identities."
    },
    {
      "checkKey": "catalog-review.attributes.all-nine-present",
      "required": true,
      "description": "All nine current-slice Attribute identities are present."
    },
    {
      "checkKey": "catalog-review.attributes.category-bindings-valid",
      "required": true,
      "description": "Physical, Social, and Mental category assignments are valid."
    },
    {
      "checkKey": "catalog-review.attributes.stable-order-valid",
      "required": true,
      "description": "The declared Attribute order is stable and deterministic."
    },
    {
      "checkKey": "catalog-review.abilities.category-bindings-valid",
      "required": true,
      "description": "Talent, Skill, and Knowledge category assignments are valid."
    },
    {
      "checkKey": "catalog-review.abilities.lupus-restriction-keys-resolve",
      "required": true,
      "description": "Every Lupus-restricted Ability key resolves to a reviewed Ability identity."
    },
    {
      "checkKey": "catalog-review.abilities.stable-order-valid",
      "required": true,
      "description": "The declared Ability order is stable and deterministic."
    },
    {
      "checkKey": "catalog-review.backgrounds.tribe-restriction-bindings-resolve",
      "required": true,
      "description": "Any Tribe-specific Background restriction references valid reviewed identities."
    },
    {
      "checkKey": "catalog-review.backgrounds.stable-order-valid",
      "required": true,
      "description": "The declared Background order is stable and deterministic."
    },
    {
      "checkKey": "catalog-review.metis-deformities.candidate-identity-resolved",
      "required": true,
      "description": "The candidate Metis deformity identity receives a final source-backed decision."
    },
    {
      "checkKey": "catalog-review.metis-deformities.metis-only-binding-valid",
      "required": true,
      "description": "The deformity catalog is applicable only when Race is Metis."
    },
    {
      "checkKey": "catalog-review.metis-deformities.fixture-impact-reconciled",
      "required": true,
      "description": "All fixtures using the deformity identity are updated and fingerprinted."
    },
    {
      "checkKey": "catalog-review.ranks.initial-rank-identity-valid",
      "required": true,
      "description": "Cliath is the reviewed initial Rank identity."
    },
    {
      "checkKey": "catalog-review.ranks.numeric-binding-valid",
      "required": true,
      "description": "The initial Rank identity binds to numeric Rank 1."
    },
    {
      "checkKey": "catalog-review.initial-gifts.candidate-identities-resolved",
      "required": true,
      "description": "Every current-slice initial Gift candidate receives a final source-backed identity decision."
    },
    {
      "checkKey": "catalog-review.initial-gifts.level-one-binding-valid",
      "required": true,
      "description": "Every current-slice initial Gift is reviewed as Level One."
    },
    {
      "checkKey": "catalog-review.initial-gifts.classification-eligibility-valid",
      "required": true,
      "description": "Each Gift binds to exactly one valid Race, Auspice, or Tribe initial slot."
    },
    {
      "checkKey": "catalog-review.initial-gifts.runtime-effect-text-not-required",
      "required": true,
      "description": "Runtime effect text is not required for ownership-only Character creation support."
    },
    {
      "checkKey": "catalog-review.initial-gifts.additional-purchase-remains-blocked",
      "required": true,
      "description": "Reviewing initial Gift identities does not enable additional Gift purchases."
    }
  ],
