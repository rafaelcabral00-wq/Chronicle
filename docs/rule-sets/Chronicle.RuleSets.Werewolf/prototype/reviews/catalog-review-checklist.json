{
  "contractVersion": 1,
  "artifactKey": "werewolf-prototype.catalog-review-checklist",
  "artifactVersion": "0.1.0-prototype",
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "werewolf-prototype.catalog-review-checklist.display-name",
  "publicationStatus": "review-working-record",
  "scope": "CurrentSliceCatalogReviewChecklist",
  "purpose": [
    "Provide the executable checklist used to review every current-slice catalog identity.",
    "Standardize source verification, key normalization, classification bindings, localization requirements, fixture impact, test impact, and promotion readiness.",
    "Ensure catalog review work produces complete, auditable, and comparable evidence across all catalogs.",
    "Prevent partial approval, skipped checks, and implicit acceptance of candidate identities."
  ],
  "authority": {
    "checklistDefinitionAuthority": "RuleSetExtractionAndReview",
    "reviewExecutionAuthority": "AssignedCatalogReviewer",
    "completionValidationAuthority": "ChronicleDeliveryInfrastructure",
    "promotionEvidenceAuthority": "ChronicleBuildAndReleaseInfrastructure",
    "automaticCheckCompletionAllowed": false,
    "implementationMayMarkReviewComplete": false,
    "narratorMayModify": false,
    "chronicleDirectorMayModify": false
  },
  "reviewBindings": {
    "catalogIdentityReviewArtifactRef": "./catalog-identity-review.json",
    "catalogIdentityDecisionArtifactRef": "./catalog-identity-decisions.json",
    "reviewModelIndexArtifactRef": "./review-model-index.json",
    "workPackageKey": "delivery.wp.review-catalog-identities"
  },
  "checkStatusModel": {
    "allowedStatuses": [
      "not-started",
      "in-progress",
      "passed",
      "failed",
      "blocked",
      "not-applicable"
    ],
    "passedRequiresEvidence": true,
    "notApplicableRequiresRationale": true,
    "failedRequiresIssueKey": true,
    "blockedRequiresBlockingReasonKey": true,
    "manualOverallApprovalWithoutPassedRequiredChecksAllowed": false
  },
  "commonChecklist": [
    {
      "checkKey": "catalog-review.artifact-loads",
      "category": "contract",
      "required": true,
      "description": "The catalog artifact loads successfully under its declared contract version.",
      "requiredEvidenceTypes": [
        "contract-validation-report"
      ]
    },
    {
      "checkKey": "catalog-review.catalog-key-matches-index",
      "category": "contract",
      "required": true,
      "description": "The catalog key, artifact key, and index binding reconcile.",
      "requiredEvidenceTypes": [
        "contract-validation-report"
      ]
    },
    {
      "checkKey": "catalog-review.entry-keys-unique",
      "category": "identity",
      "required": true,
      "description": "Every entry key in the catalog is unique.",
      "requiredEvidenceTypes": [
        "catalog-review-record"
      ]
    },
    {
      "checkKey": "catalog-review.source-name-match",
      "category": "source",
      "required": true,
      "description": "The source-backed identity name matches the intended catalog entry.",
      "requiredEvidenceTypes": [
        "source-review-record"
      ]
    },
    {
      "checkKey": "catalog-review.normalized-key-stable",
      "category": "identity",
      "required": true,
      "description": "The normalized technical key is stable, unambiguous, and compliant with naming policy.",
      "requiredEvidenceTypes": [
        "catalog-review-record"
      ]
    },
    {
      "checkKey": "catalog-review.display-name-not-used-as-identity",
      "category": "identity",
      "required": true,
      "description": "Display names and localized text are not used as persistent identifiers.",
      "requiredEvidenceTypes": [
        "catalog-review-record"
      ]
    },
    {
      "checkKey": "catalog-review.localization-key-present",
      "category": "localization",
      "required": true,
      "description": "Every current-slice entry declares a localization resource key.",
      "requiredEvidenceTypes": [
        "localization-validation-report"
      ]
    },
    {
      "checkKey": "catalog-review.required-entry-present",
      "category": "coverage",
      "required": true,
      "description": "Every current-slice required identity is present.",
      "requiredEvidenceTypes": [
        "catalog-review-record"
      ]
    },
    {
      "checkKey": "catalog-review.fixture-references-resolve",
      "category": "fixtures",
      "required": true,
      "description": "Every fixture reference to the catalog resolves to an active reviewed identity.",
      "requiredEvidenceTypes": [
        "fixture-validation-report"
      ]
    },
    {
      "checkKey": "catalog-review.operation-bindings-resolve",
      "category": "operations",
      "required": true,
      "description": "Every operation binding using catalog identities resolves.",
      "requiredEvidenceTypes": [
        "contract-validation-report"
      ]
    },
    {
      "checkKey": "catalog-review.validation-bindings-resolve",
      "category": "validation",
      "required": true,
      "description": "Every validation rule using catalog identities resolves.",
      "requiredEvidenceTypes": [
        "contract-validation-report"
      ]
    },
    {
      "checkKey": "catalog-review.test-bindings-resolve",
      "category": "tests",
      "required": true,
      "description": "Every required test using catalog identities resolves.",
      "requiredEvidenceTypes": [
        "test-run-report"
      ]
    },
    {
      "checkKey": "catalog-review.no-raw-source-text",
      "category": "security",
      "required": true,
      "description": "The catalog does not embed raw sourcebook text.",
      "requiredEvidenceTypes": [
        "security-review-record"
      ]
    },
    {
      "checkKey": "catalog-review.decision-recorded",
      "category": "review",
      "required": true,
      "description": "Every required identity has exactly one active formal decision.",
      "requiredEvidenceTypes": [
        "review-record"
      ]
    },
    {
      "checkKey": "catalog-review.affected-artifacts-reconciled",
      "category": "reconciliation",
      "required": true,
      "description": "All artifacts affected by identity changes have been updated and fingerprinted.",
      "requiredEvidenceTypes": [
        "reconciliation-report"
      ]
    }
  ],
  "catalogChecklists": [
