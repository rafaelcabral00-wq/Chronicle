  "consistencyRules": [
    {
      "ruleKey": "catalog-review-checklist.catalog-keys-unique",
      "severity": "blocking",
      "requirement": "every catalogKey appears exactly once"
    },
    {
      "ruleKey": "catalog-review-checklist.check-keys-unique",
      "severity": "blocking",
      "requirement": "every common and specific checkKey is unique"
    },
    {
      "ruleKey": "catalog-review-checklist.check-refs-resolve",
      "severity": "blocking",
      "requirement": "every catalog-specific check reference resolves"
    },
    {
      "ruleKey": "catalog-review-checklist.required-identities-resolve",
      "severity": "blocking",
      "requirement": "every required identity key resolves in its catalog"
    },
    {
      "ruleKey": "catalog-review-checklist.passed-check-has-evidence",
      "severity": "blocking",
      "requirement": "every passed check has a complete evidence record"
    },
    {
      "ruleKey": "catalog-review-checklist.status-counts-reconcile",
      "severity": "blocking",
      "requirement": "currentStatus counts reconcile with catalog and evidence states"
    },
    {
      "ruleKey": "catalog-review-checklist.no-implicit-approval",
      "severity": "blocking",
      "requirement": "catalog approval requires all required checks and formal decisions"
    }
  ],
