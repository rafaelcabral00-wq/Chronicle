    "readyRequiresPreconditions": true,
    "inProgressRequiresOwner": true,
    "blockedRequiresReasonKey": true,
    "submittedRequiresOutputsAndEvidence": true,
    "validatedRequiresIndependentValidation": true,
    "completeRequiresValidatedOutputs": true,
    "staleRequiresChangedInputFingerprint": true,
    "supersededRequiresReplacementActionKey": true
  },
