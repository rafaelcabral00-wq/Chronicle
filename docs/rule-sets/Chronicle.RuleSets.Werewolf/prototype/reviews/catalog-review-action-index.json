  "dispatchPolicy": {
    "dispatchRequiresActionKnown": true,
    "dispatchRequiresPreconditionsSatisfied": true,
    "dispatchRequiresOwnerAssigned": true,
    "dispatchRequiresCurrentInputFingerprints": true,
    "parallelDispatchAllowedWhenInputsDoNotConflict": true,
    "sharedDecisionSetWritesRequireSerialization": true,
    "networkDispatchRequired": false,
    "hardcodedFallbackAllowed": false
  },
  "completionPolicy": {
    "actionCompleteWhen": "all-completion-criteria-have-current-validated-evidence",
    "issueResolutionActionCompleteWhen": "issue-resolution-evidence-recorded-and-verified",
    "finalizationActionCompleteWhen": "decision-set-finalized-and-dependent-statuses-recalculated",
    "manualCompletionAllowed": false,
    "candidateTemplateMayNotSatisfyCompletion": true
  },
  "issueIntegration": {
    "resolutionActionKeysMustResolve": true,
    "openBlockingIssueKeepsRequiredActionsVisible": true,
    "verifiedIssueRequiresAllResolutionActionsComplete": true,
    "reopenedIssueMayMarkCompletedActionsStale": true,
    "unrelatedIssuesMayNotBlockActionDispatch": true
  },
  "taskIntegration": {
    "actionMaySatisfyOneOrMoreTaskOutputs": true,
    "taskCannotCompleteUntilRequiredActionsComplete": true,
    "actionOutputFingerprintsMustBindToTaskEvidence": true,
    "staleActionReopensDependentTask": true
  },
  "stalenessPolicy": {
    "changedSourceFingerprintMarksSourceReviewActionsStale": true,
    "changedCatalogFingerprintMarksDependentActionsStale": true,
    "changedDecisionFingerprintMarksReconciliationActionsStale": true,
    "changedFixtureFingerprintMarksFixtureActionsStale": true,
    "changedTestReportFingerprintMarksFinalizationActionStale": true,
    "automaticStaleTransitionAllowed": true,
    "silentOutputReuseAllowed": false
  },
  "consistencyRules": [
    {
      "ruleKey": "catalog-review-action-index.action-keys-unique",
      "severity": "blocking",
      "requirement": "every actionKey is unique"
    },
    {
      "ruleKey": "catalog-review-action-index.issue-action-refs-resolve",
      "severity": "blocking",
      "requirement": "every issue resolutionActionKey resolves to a declared action"
    },
    {
      "ruleKey": "catalog-review-action-index.preconditions-resolve",
      "severity": "blocking",
      "requirement": "every action precondition resolves to a known task, stage, action, evidence state, or model state"
    },
    {
      "ruleKey": "catalog-review-action-index.dependencies-acyclic",
      "severity": "blocking",
      "requirement": "action dependencies are acyclic"
    },
    {
      "ruleKey": "catalog-review-action-index.complete-actions-have-evidence",
      "severity": "blocking",
      "requirement": "every complete action has current validated output evidence"
    },
    {
      "ruleKey": "catalog-review-action-index.summary-reconciles",
      "severity": "blocking",
      "requirement": "actionSummary counts reconcile with action records"
    },
    {
      "ruleKey": "catalog-review-action-index.no-implicit-resolution",
      "severity": "blocking",
      "requirement": "issue notes, artifact presence, or candidate templates never imply action completion"
    }
  ],
  "fingerprintPolicy": {
    "actionIndexFingerprintRequired": true,
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "includeBindings": true,
    "includeActionDefinitions": true,
    "includeActionSummary": true,
    "includeDispatchCompletionAndStalenessPolicies": true,
    "includeIssueAndTaskIntegration": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncluded": false
  },
  "diagnosticProjection": {
    "include": [
      "action-statuses",
      "ready-action-keys",
      "blocked-action-keys",
      "stale-action-keys",
