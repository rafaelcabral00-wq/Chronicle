{
  "contractVersion": 1,
  "artifactKey": "werewolf-prototype.catalog-review-action-index",
  "artifactVersion": "0.1.0-prototype",
  "packageId": "chronicle.rulesets.werewolf",
  "displayNameResourceKey": "werewolf-prototype.catalog-review-action-index.display-name",
  "publicationStatus": "review-working-record",
  "scope": "CurrentSliceCatalogReviewActions",
  "purpose": [
    "Provide the canonical registry of resolution and execution actions used by catalog review tasks and issues.",
    "Define required inputs, owners, outputs, preconditions, side effects, evidence requirements, and completion rules for every catalog review action.",
    "Allow Chronicle delivery infrastructure to dispatch and validate review actions without hardcoded Werewolf-specific workflow logic.",
    "Prevent ambiguous issue-resolution notes from being treated as executable or complete work."
  ],
  "authority": {
    "actionModelAuthority": "ChronicleArchitecture",
    "substantiveActionAuthority": "AssignedActionOwner",
    "dispatchAuthority": "ChronicleDeliveryInfrastructure",
    "validationAuthority": "ChronicleDeliveryInfrastructure",
    "promotionEvidenceAuthority": "ChronicleBuildAndReleaseInfrastructure",
    "automaticDispatchAllowed": false,
    "automaticCompletionAllowed": false,
    "implementationMayInventMissingAction": false,
    "narratorMayModify": false,
    "chronicleDirectorMayModify": false
  },
  "bindings": {
    "catalogReviewIssuesArtifactRef": "./catalog-review-issues.json",
    "catalogReviewExecutionPlanArtifactRef": "./catalog-review-execution-plan.json",
    "catalogReviewTaskStatusArtifactRef": "./catalog-review-task-status.json",
    "catalogReviewEvidenceArtifactRef": "./catalog-review-evidence.json",
    "catalogIdentityDecisionsArtifactRef": "./catalog-identity-decisions.json",
    "catalogReviewResultArtifactRef": "./catalog-review-result.json",
    "workPackageKey": "delivery.wp.review-catalog-identities"
  },
