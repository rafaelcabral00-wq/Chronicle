    "recordWithActiveBlockerCount": 9,
    "currentRecordKey": "catalog-review-record.abilities",
    "nextRecordKey": "catalog-review-record.abilities"
  },
  "recordStatusModel": {
    "allowedStatuses": [
      "not-started",
      "ready",
      "in-progress",
      "blocked-pending-source-review",
      "blocked",
      "complete",
      "stale",
      "superseded"
    ],
    "readyRequiresTaskReady": true,
    "inProgressRequiresAssignedReviewer": true,
    "blockedRequiresIssueOrBlocker": true,
    "completeRequiresRecordCompletionPolicy": true,
    "staleRequiresChangedInputFingerprint": true,
    "supersededRequiresReplacementRecordKey": true
  },
  "discoveryPolicy": {
    "allRequiredCatalogsMustHaveOneRecord": true,
    "recordArtifactRefMustResolve": true,
    "recordCatalogKeyMustMatchIndex": true,
    "recordTaskKeyMustResolve": true,
    "recordRequiredIdentityCountMustReconcile": true,
    "recordDecisionIdsMustReconcileWithDecisionSet": true,
    "recordIssueAndBlockerRefsMustResolve": true,
    "extraRecordsAllowedOnlyForDeclaredFutureScope": true,
    "hardcodedCatalogPathFallbackAllowed": false
  },
  "executionPolicy": {
    "structuralValidationMustCompleteBeforeSubstantiveRecordsBecomeReady": true,
    "recordExecutionOrderFollowsExecutionPlan": true,
    "parallelReviewAllowedOnlyWhenTaskDependenciesPermit": true,
    "blockedRecordMayNotBeSkippedSilently": true,
    "recordCompletionRecalculatesTaskAndStageState": true,
    "allRecordsCompleteRequiredBeforeDecisionSetFinalization": true
  },
  "completionPolicy": {
    "indexCompleteWhen": [
      "all-nine-record-artifacts-resolve",
      "all-nine-records-complete",
      "all-46-active-final-decisions-recorded",
      "all-record-evidence-current",
      "all-record-issues-resolved",
      "all-required-blockers-verified",
      "all-affected-artifacts-fixtures-and-tests-reconciled",
      "index-fingerprint-recorded"
    ],
    "currentCompletionEligible": false,
    "manualCompletionAllowed": false,
    "candidateOrBlockedRecordMayNotSatisfyCompletion": true
  },
  "stateIntegration": {
    "recordStatusFeedsCatalogStateProjection": true,
    "recordIssuesFeedIssueSummary": true,
    "recordBlockersFeedBlockerSummary": true,
    "recordDecisionIdsFeedUnresolvedIdentityCount": true,
    "recordCompletionFeedsTaskAndStageCompletion": true,
    "recordStalenessReopensDependentReviewState": true
  },
  "promotionIntegration": {
    "allRecordsCompleteRequiredForSourceReviewApproval": true,
    "allRecordEvidenceCurrentRequiredForSemanticApproval": true,
    "allAffectedFixturesAndTestsMustPass": true,
    "blockedOrStaleRecordFailsPromotionEvidenceEligibility": true,
    "promotionReportMustListIncompleteRecordKeys": true
  },
  "consistencyRules": [
    {
      "ruleKey": "catalog-review-record-index.record-keys-unique",
      "severity": "blocking",
      "requirement": "every recordKey is unique"
    },
    {
      "ruleKey": "catalog-review-record-index.catalog-coverage-complete",
      "severity": "blocking",
      "requirement": "all nine required catalogs appear exactly once"
    },
    {
      "ruleKey": "catalog-review-record-index.identity-counts-reconcile",
      "severity": "blocking",
      "requirement": "all record requiredIdentityCount values sum to 46"
    },
    {
      "ruleKey": "catalog-review-record-index.artifact-refs-resolve",
      "severity": "blocking",
      "requirement": "every record artifactRef resolves"
    },
    {
      "ruleKey": "catalog-review-record-index.task-refs-resolve",
      "severity": "blocking",
      "requirement": "every record taskKey resolves"
    },
    {
      "ruleKey": "catalog-review-record-index.issue-and-blocker-refs-resolve",
      "severity": "blocking",
      "requirement": "every issue and blocker reference resolves"
    },
    {
      "ruleKey": "catalog-review-record-index.decision-ids-unique",
      "severity": "blocking",
      "requirement": "every required identity decision ID appears in exactly one record"
    },
    {
      "ruleKey": "catalog-review-record-index.status-reconciles",
      "severity": "blocking",
      "requirement": "record statuses reconcile with source record artifacts, tasks, issues, blockers, evidence, and decisions"
    },
    {
      "ruleKey": "catalog-review-record-index.summary-reconciles",
      "severity": "blocking",
      "requirement": "recordSummary counts reconcile with record entries"
    }
  ],
  "fingerprintPolicy": {
    "recordIndexFingerprintRequired": true,
    "algorithm": "SHA-256",
    "canonicalSerialization": true,
    "canonicalPropertyOrderingRequired": true,
    "includeBindings": true,
    "includeRecordEntries": true,
    "includeRecordSummary": true,
    "includeDiscoveryExecutionAndCompletionPolicies": true,
    "includeStateAndPromotionIntegration": true,
    "unicodeNormalization": "NFC",
    "nullFieldsIncluded": false
  },
  "diagnosticProjection": {
    "include": [
      "record-statuses",
      "missing-record-keys",
      "unresolved-record-artifact-refs",
      "record-task-key-mismatches",
      "record-identity-count-mismatches",
      "records-with-open-issues",
      "records-with-active-blockers",
      "records-with-missing-decisions",
      "records-with-stale-evidence",
      "current-record-key",
      "next-record-key",
      "index-completion-eligibility"
    ],
    "developerDetailsOnlyInDeveloperMode": true,
    "rawSourceTextIncluded": false,
    "sourcebookTextIncluded": false,
    "secretsIncluded": false
  },
  "securityPolicy": {
    "networkAccessRequired": false,
    "providerAccessRequired": false,
    "containsProductionUserData": false,
    "containsProviderSecrets": false,
    "ordinaryLogsMayContain": [
      "recordKeys",
      "catalogKeys",
      "taskKeys",
      "issueKeys",
      "blockerKeys",
      "decisionIds",
      "fixtureKeys",
      "statuses",
      "counts",
