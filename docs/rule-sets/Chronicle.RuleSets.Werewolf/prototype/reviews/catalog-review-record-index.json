        "packageId": "Text",
        "recordKey": "Reference",
        "previousStatus": "Text",
        "newStatus": "Text",
        "recordIndexFingerprint": "Text",
        "changedAt": "Text"
      }
    }
  ],
  "review": {
    "sourceRuleDependency": "indirect-through-records",
    "architectureConfidence": "high",
    "indexStatus": "ready",
    "recordExecutionStatus": "not-started",
    "blockedRecordStatus": "active",
    "decisionStatus": "draft",
    "promotionReviewStatus": "blocked"
  },
  "prototypeNotes": [
    "This index registers nine substantive catalog review records covering all 46 required identities.",
    "Seven records are not started and two are explicitly blocked pending source review.",
    "The index creates no findings, evidence, decisions, approvals, or completed work.",
    "The next substantive record is the Race review record after structural validation tasks complete.",
    "Chronicle owns discovery, reference validation, status aggregation, staleness propagation, diagnostics, fingerprints, task integration, and promotion enforcement.",
    "Assigned Rule Set reviewers remain responsible for substantive findings, evidence, and final identity recommendations."
  ]
