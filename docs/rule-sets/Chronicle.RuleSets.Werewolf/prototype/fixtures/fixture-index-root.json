  "consistencyRules": [
    {
      "ruleKey": "prototype-fixture-index.collection-keys-unique",
      "severity": "blocking",
      "requirement": "every fixture collection key is unique"
    },
    {
      "ruleKey": "prototype-fixture-index.required-refs-resolve",
      "severity": "blocking",
      "requirement": "every required fixture collection reference resolves inside the fixture root"
    },
    {
      "ruleKey": "prototype-fixture-index.dependencies-acyclic",
      "severity": "blocking",
      "requirement": "fixture collection dependencies are acyclic"
    },
    {
      "ruleKey": "prototype-fixture-index.external-dependencies-valid",
      "severity": "blocking",
      "requirement": "all required prototype model indexes load successfully"
    },
    {
      "ruleKey": "prototype-fixture-index.test-suite-refs-known",
      "severity": "blocking",
      "requirement": "every test-suite collection reference is indexed or explicitly future"
    },
    {
      "ruleKey": "prototype-fixture-index.coverage-counts-reconcile",
      "severity": "blocking",
      "requirement": "coverage summary counts reconcile with indexed, blocked, and future collections"
    },
    {
      "ruleKey": "prototype-fixture-index.blocked-collections-declare-reason",
      "severity": "blocking",
      "requirement": "every blocked collection declares a stable blocking reason"
    }
