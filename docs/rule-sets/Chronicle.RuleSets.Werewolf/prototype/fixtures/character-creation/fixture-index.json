  "consistencyRules": [
    {
      "ruleKey": "fixture-index.fixture-keys-unique",
      "severity": "blocking",
      "requirement": "every fixtureKey is unique"
    },
    {
      "ruleKey": "fixture-index.refs-resolve",
      "severity": "blocking",
      "requirement": "every fixture artifact reference resolves inside the Character creation fixture root"
    },
    {
      "ruleKey": "fixture-index.base-fixture-refs-resolve",
      "severity": "blocking",
      "requirement": "every base fixture reference resolves and appears earlier in load order"
    },
    {
      "ruleKey": "fixture-index.dependencies-acyclic",
      "severity": "blocking",
      "requirement": "fixture dependencies and base-fixture relationships are acyclic"
    },
    {
      "ruleKey": "fixture-index.expected-outcomes-present",
      "severity": "blocking",
      "requirement": "every fixture declares a stable expected outcome"
    },
    {
      "ruleKey": "fixture-index.invalid-fixtures-declare-repair-or-terminal-state",
      "severity": "blocking",
      "requirement": "every invalid fixture declares either a repair path or an intentionally terminal unsupported state"
    },
    {
      "ruleKey": "fixture-index.test-suite-refs-known",
      "severity": "blocking",
      "requirement": "every test-suite fixture reference resolves to an indexed fixture"
    },
    {
      "ruleKey": "fixture-index.coverage-counts-reconcile",
      "severity": "blocking",
      "requirement": "coverage summary counts reconcile with indexed fixture kinds"
    }
  ],
