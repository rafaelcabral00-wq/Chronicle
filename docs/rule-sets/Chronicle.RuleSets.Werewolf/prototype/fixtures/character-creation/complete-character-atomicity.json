  "publicationStatus": "prototype-candidate",
  "purpose": [
    "Provide one deterministic transaction fixture for complete-character atomicity.",
    "Verify that final validation, warning acknowledgement checks, ledger freezing, Character activation, completion snapshot creation, and event emission succeed or fail as one atomic unit.",
    "Ensure no partial state survives when a failure occurs after validation but before transaction commit.",
    "Serve as a shared input for transaction, persistence, recovery, idempotency, and event tests."
  ],
  "binding": {
    "characterModelId": "chronicle.rulesets.werewolf.character-model",
    "characterModelVersion": "0.1.0-prototype",
