  "validationFailureScenario": {
    "scenarioKey": "fresh-validation-rejects-completion",
    "mutationBeforeOperation": {
      "instruction": "Remove one required warning acknowledgement or introduce one blocking invalidation without changing the operation request."
    },
    "expectedResult": {
      "operationStatus": "rejected",
      "failureKey": "character-creation.complete-character.validation-failed",
      "freshValidationReturned": true,
      "characterStatus": "Draft",
      "creationLedgerStatus": "open",
      "completionSnapshotCreated": false,
      "transactionCommitted": false,
      "partialCommitOccurred": false
    }
  },
  "idempotencyExpectations": {
    "sameKeySameRequestAfterSuccess": {
      "executeTransactionAgain": false,
      "returnOriginalSuccessResult": true,
      "createSecondSnapshot": false,
      "emitDuplicateEvents": false,
      "incrementCharacterVersionAgain": false
    },
    "sameKeyDifferentRequest": {
      "operationStatus": "rejected",
      "failureKey": "operation.idempotency-key-conflict"
    },
    "retryAfterRolledBackFailure": {
      "allowed": true,
      "mustRerunFreshValidation": true,
      "mayReuseSameIdempotencyKey": "only-when-no-success-result-was-committed"
    }
  },
  "snapshotExpectations": {
    "createdOnlyInsideTransaction": true,
    "immutableAfterCommit": true,
    "containsCharacterState": true,
    "containsCreationLedgerFingerprint": true,
    "containsValidationResultFingerprint": true,
    "containsWarningAcknowledgementFingerprints": true,
    "containsPackageBinding": true,
    "containsSourceArtifactFingerprints": true,
    "containsRawSourcebookText": false
  },
  "recoveryExpectations": {
    "crashBeforeCommit": {
      "databaseRecoveryResult": "all-uncommitted-changes-rolled-back",
      "characterStatus": "Draft",
      "creationLedgerStatus": "open",
      "completionSnapshotExists": false
    },
    "crashAfterCommitBefore-ui-response": {
      "databaseRecoveryResult": "committed-success-preserved",
      "idempotentRetryReturnsCommittedResult": true,
      "duplicateSnapshotCreated": false,
      "duplicateEventsAppended": false
    }
  },
  "consistencyAssertions": [
    "An Active Character always has a frozen creation ledger.",
    "An Active Character produced through creation completion always has exactly one completion snapshot for that completion transaction.",
    "A frozen creation ledger cannot coexist with a Draft Character after transaction recovery.",
    "A completion snapshot cannot survive a rolled-back completion transaction.",
    "Completion events are not externally published before commit.",
    "Fresh validation is executed inside the authoritative completion transaction.",
    "Cached review or validation projections never authorize commit."
  ],
  "negativeAssertions": [
    "No partial activation is allowed.",
    "No ledger remains frozen after a failed or rolled-back completion.",
    "No completion snapshot remains after rollback.",
    "No success idempotency record is committed for a failed transaction.",
    "No completion event is published before successful commit.",
    "No Narrator, Narrative Intelligence provider, or Chronicle Director participates in authority decisions."
  ],
  "testUses": [
    "complete-character-success",
    "complete-character-validation-rejection",
    "completion-transaction-rollback",
    "completion-snapshot-atomicity",
    "ledger-freeze-atomicity",
    "character-activation-atomicity",
    "event-outbox-after-commit",
    "idempotent-completion-retry",
    "crash-recovery-before-and-after-commit"
  ],
